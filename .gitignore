# Visual Studio 2015 user specific files
.vs/
.idea/
.idea/.idea.Tortunabo.dir
.idea/.idea.Tortunabo
.idea/.idea.Tortunabo/.idea
.idea/.idea.Tortunabo/.idea/workspace.xml
.claude/*
!.claude/skills/
# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app
*.ipa

# These project files can be generated by the engine
*.xcodeproj
*.xcworkspace
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb

# Precompiled Assets
SourceArt/**/*.png
SourceArt/**/*.tga

# Binary Files
Binaries/*
Plugins/**/Binaries/*

# Builds
Build/*

# Whitelist PakBlacklist-<BuildConfiguration>.txt files
!Build/*/
Build/*/**
!Build/*/PakBlacklist*.txt

# Don't ignore icon files in Build
!Build/**/*.ico

# Built data for maps
*_BuiltData.uasset

# Configuration files generated by the Editor
Saved/*

# Compiled source files for the engine to use
Intermediate/*
Plugins/**/Intermediate/*

# Cache files for the editor to use
DerivedDataCache/*

# Claude Code session log (local, ephemeral)
.claude/session-log.md

# CodeGraph index (local code-intelligence cache, regenerated on demand)
.codegraph/

# MCP de Unreal (plugin de terceros, solo editor): se versiona Source/Content/Resources
# (1,8 MB); Binaries e Intermediate los excluyen las reglas genericas y se compilan con el proyecto.

# Python
__pycache__/
*.pyc

# Documentos pesados de entrega (PDF) — fuera del repositorio
*.pdf

# Mapa volumetrico: los trozos binarios se regeneran con Scripts/gen_terrain_volume.py (semilla fija)
Scripts/terrain_volumes/*/Chunks/

# Entorno de uv de las herramientas Python
.venv/

# Rejilla del agua: se regenera con Scripts/gen_water_textures.py
Scripts/textures/WaterSurface.bin

# Mapas a partir de fotos (retratos): reproducen el relieve de una persona; no se suben (ver gen_terrain_portrait.py)
Scripts/terrain_volumes/Variants/F*/

# Cachés de herramientas (pytest, ruff, rumdl, superpowers)
.pytest_cache/
.rumdl_cache/
.ruff_cache/
.superpowers/

# Logs de ejecución (Source/Logs: los registros que se guardaban junto al código; no van al repo)
*.log
Source/Logs/

# Carpetas personales del editor
Content/Developers/
Docs/Mapas/Supervivencia/trazados_ascii.txt
