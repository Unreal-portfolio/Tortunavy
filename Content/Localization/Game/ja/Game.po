msgid "Suelta lo de la aleta (y vuelve a cogerlo)"
msgstr "ヒレのものを手放して、また拾おう"

#. Key:	TaskThrow
#. SourceLocation:	Source/Tortunabo/Private/Lobby/TN_TutorialTexts.h(56)
#: Source/Tortunabo/Private/Lobby/TN_TutorialTexts.h(56)
msgctxt "TNTutorial,TaskThrow"
msgid "Con la bola en la aleta, apunta con la cámara y dale al cangrejo"
msgstr "ヒレにボールを持って、カメラで狙ってカニに当てよう"

#. Key:	TaskUse
#. SourceLocation:	Source/Tortunabo/Private/Lobby/TN_TutorialTexts.h(57)
#: Source/Tortunabo/Private/Lobby/TN_TutorialTexts.h(57)
