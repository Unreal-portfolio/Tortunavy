#: Source/Tortunabo/Private/Lobby/TN_TutorialTexts.h(59)
msgctxt "TNTutorial,TaskShellIn"
msgid "Métete en el caparazón y rueda cuesta abajo"
msgstr "縮進龜殼，滾下坡去"

#. Key:	TaskShellOut
#. SourceLocation:	Source/Tortunabo/Private/Lobby/TN_TutorialTexts.h(60)
#: Source/Tortunabo/Private/Lobby/TN_TutorialTexts.h(60)
msgctxt "TNTutorial,TaskShellOut"
msgid "Sal con la misma tecla"
msgstr "按同一個鍵鑽出來"

#. Key:	TaskTrampoline
#. SourceLocation:	Source/Tortunabo/Private/Lobby/TN_TutorialTexts.h(61)
#: Source/Tortunabo/Private/Lobby/TN_TutorialTexts.h(61)
msgctxt "TNTutorial,TaskTrampoline"
msgid "Salta encima de la medusa para subir a la roca"
msgstr "跳到水母上，彈上岩石"

#. Key:	TaskCatapult
#. SourceLocation:	Source/Tortunabo/Private/Lobby/TN_TutorialTexts.h(62)
#: Source/Tortunabo/Private/Lobby/TN_TutorialTexts.h(62)
msgctxt "TNTutorial,TaskCatapult"
msgid "Métete en la cuchara, de pie o hecha bola, y vuela al otro lado"
msgstr "站在彈射勺上或者縮成球，飛到另一邊去"

#. Key:	TaskSwim
#. SourceLocation:	Source/Tortunabo/Private/Lobby/TN_TutorialTexts.h(64)
#: Source/Tortunabo/Private/Lobby/TN_TutorialTexts.h(64)
msgctxt "TNTutorial,TaskSwim"
msgid "Cruza la laguna nadando"
msgstr "游過水塘"

#. Key:	TaskSwimOut
#. SourceLocation:	Source/Tortunabo/Private/Lobby/TN_TutorialTexts.h(65)
#: Source/Tortunabo/Private/Lobby/TN_TutorialTexts.h(65)
msgctxt "TNTutorial,TaskSwimOut"
msgid "Salta para salir del agua"
msgstr "跳起來爬上岸"

#. Key:	TaskGrab
#. SourceLocation:	Source/Tortunabo/Private/Lobby/TN_TutorialTexts.h(67)
#: Source/Tortunabo/Private/Lobby/TN_TutorialTexts.h(67)
msgctxt "TNTutorial,TaskGrab"
msgid "Coge a Rodolfo, que está en su caparazón"
msgstr "抱起躲在殼裡的 Rodolfo"

#. Key:	TaskToss
#. SourceLocation:	Source/Tortunabo/Private/Lobby/TN_TutorialTexts.h(68)
#: Source/Tortunabo/Private/Lobby/TN_TutorialTexts.h(68)
msgctxt "TNTutorial,TaskToss"
msgid "Lánzalo (o déjalo en el suelo con la tecla de soltar)"
msgstr "把他丟出去（或者用放下鍵放到地上）"

#. Key:	TaskGetGrabbed
#. SourceLocation:	Source/Tortunabo/Private/Lobby/TN_TutorialTexts.h(70)
#: Source/Tortunabo/Private/Lobby/TN_TutorialTexts.h(70)
msgctxt "TNTutorial,TaskGetGrabbed"
msgid "Métete en el caparazón junto a Berta: te cogerá"
msgstr "縮進殼裡，湊到 Berta 身邊：她會抱起你"

#. Key:	TaskStruggle
#. SourceLocation:	Source/Tortunabo/Private/Lobby/TN_TutorialTexts.h(71)
#: Source/Tortunabo/Private/Lobby/TN_TutorialTexts.h(71)
msgctxt "TNTutorial,TaskStruggle"
msgid "Muévete sin parar para soltarte"
msgstr "不停地動來掙脫"

#. Key:	TaskEmote
#. SourceLocation:	Source/Tortunabo/Private/Lobby/TN_TutorialTexts.h(73)
#: Source/Tortunabo/Private/Lobby/TN_TutorialTexts.h(73)
msgctxt "TNTutorial,TaskEmote"
msgid "Mantén, elige un baile y suelta"
msgstr "按住，選一個舞蹈，放開"

#. Key:	TaskChat
#. SourceLocation:	Source/Tortunabo/Private/Lobby/TN_TutorialTexts.h(74)
#: Source/Tortunabo/Private/Lobby/TN_TutorialTexts.h(74)
msgctxt "TNTutorial,TaskChat"
msgid "Mantén, elige una frase y suelta"
msgstr "按住，選一句話，放開"

#. Key:	TaskVoice
#. SourceLocation:	Source/Tortunabo/Private/Lobby/TN_TutorialTexts.h(75)
#: Source/Tortunabo/Private/Lobby/TN_TutorialTexts.h(75)
msgctxt "TNTutorial,TaskVoice"
msgid "Habla: te oyen las tortugas a menos de 25 m"
msgstr "說話吧：25 公尺內的小龜都能聽到你"

#. Key:	TaskPause
#. SourceLocation:	Source/Tortunabo/Private/Lobby/TN_TutorialTexts.h(76)
#: Source/Tortunabo/Private/Lobby/TN_TutorialTexts.h(76)
msgctxt "TNTutorial,TaskPause"
msgid "Abre el menú de pausa y mira los ajustes"
msgstr "打開暫停選單，看看設定"

#. Key:	TaskWaterfall
#. SourceLocation:	Source/Tortunabo/Private/Lobby/TN_TutorialTexts.h(77)
#: Source/Tortunabo/Private/Lobby/TN_TutorialTexts.h(77)
msgctxt "TNTutorial,TaskWaterfall"
msgid "Salta por la cascada: caerás en el castillo"
msgstr "從瀑布上跳下去：你會落進城堡"

#. Key:	TipWelcome
#. SourceLocation:	Source/Tortunabo/Private/Lobby/TN_TutorialTexts.h(87)
#: Source/Tortunabo/Private/Lobby/TN_TutorialTexts.h(87)
msgctxt "TNTutorial,TipWelcome"
msgid "La tortuga va hacia donde mira la cámara. Sigue el camino: cada cartel te enseña una cosa."
msgstr "小龜朝鏡頭看的方向走。沿著小路前進，每塊牌子都會教你一件事。"

#. Key:	TipSprint
#. SourceLocation:	Source/Tortunabo/Private/Lobby/TN_TutorialTexts.h(89)
#: Source/Tortunabo/Private/Lobby/TN_TutorialTexts.h(89)
msgctxt "TNTutorial,TipSprint"
msgid "El salvavidas de abajo es tu energía: se gasta al correr y, si se vacía, jadeas hasta que se recarga."
msgstr "下方的救生圈就是你的體力：奔跑會消耗，耗盡後你會喘著氣，直到恢復。"

#. Key:	TipJump
#. SourceLocation:	Source/Tortunabo/Private/Lobby/TN_TutorialTexts.h(91)
#: Source/Tortunabo/Private/Lobby/TN_TutorialTexts.h(91)
msgctxt "TNTutorial,TipJump"
msgid "Saltas algo más de un metro. Corriendo llegas más lejos."
msgstr "能跳一公尺多高，邊跑邊跳能跳得更遠。"

#. Key:	TipDive
#. SourceLocation:	Source/Tortunabo/Private/Lobby/TN_TutorialTexts.h(93)
#: Source/Tortunabo/Private/Lobby/TN_TutorialTexts.h(93)
msgctxt "TNTutorial,TipDive"
msgid "Vuelas más lejos y resbalas por el suelo: sirve para cruzar huecos y esquivar la caca de gaviota. Muévete o salta para levantarte."
msgstr "飛得更遠，還能在地上滑行：可以跨過缺口，也能閃開海鷗的糞便。想站起來就移動或跳一下。"

#. Key:	TipPickup
#. SourceLocation:	Source/Tortunabo/Private/Lobby/TN_TutorialTexts.h(95)
#: Source/Tortunabo/Private/Lobby/TN_TutorialTexts.h(95)
msgctxt "TNTutorial,TipPickup"
msgid "Lo que coges va a la aleta; si ya llevas algo, al caparazón. Todo pesa: con mucho encima te cansas antes."
msgstr "拿到的東西先放在鰭上，鰭上有東西就收進殼裡。什麼都有重量，帶得越多越容易累。"

#. Key:	TipSearch
#. SourceLocation:	Source/Tortunabo/Private/Lobby/TN_TutorialTexts.h(97)
#: Source/Tortunabo/Private/Lobby/TN_TutorialTexts.h(97)
msgctxt "TNTutorial,TipSearch"
msgid "Muchas rocas, estatuas y cajas del camino se pueden rebuscar igual: a veces sale algo."
msgstr "路上的很多岩石、雕像和箱子也可以這樣翻找，有時會翻出東西。"

#. Key:	TipSlots
#. SourceLocation:	Source/Tortunabo/Private/Lobby/TN_TutorialTexts.h(99)
#: Source/Tortunabo/Private/Lobby/TN_TutorialTexts.h(99)
msgctxt "TNTutorial,TipSlots"
msgid "Abajo, en el centro, ves lo que llevas: en la aleta y en el caparazón."
msgstr "螢幕下方中間顯示你帶著的東西：鰭上一件，殼裡一件。"

#. Key:	Header
#. SourceLocation:	Source/Tortunabo/Private/Lobby/TN_TutorialWidget.cpp(218)
#: Source/Tortunabo/Private/Lobby/TN_TutorialWidget.cpp(218)
msgctxt "TNTutorial,Header"
msgid "TUTORIAL · {0} / {1}"
msgstr "教學 · {0} / {1}"

#. Key:	ConnectFailed
#. SourceLocation:	Source/Tortunabo/Private/Multiplayer/MP_GameInstance.cpp(1850)
#: Source/Tortunabo/Private/Multiplayer/MP_GameInstance.cpp(1850)
msgctxt "TNRooms,ConnectFailed"
msgid "No se ha podido conectar con la sala: puede que el anfitrión se haya ido."
msgstr "無法連線到房間：房主可能已經離開了。"

#. Key:	HostLeft
#. SourceLocation:	Source/Tortunabo/Private/Multiplayer/MP_GameInstance.cpp(1851)
#: Source/Tortunabo/Private/Multiplayer/MP_GameInstance.cpp(1851)
msgctxt "TNRooms,HostLeft"
msgid "Se ha acabado la partida: el anfitrión se ha ido o se ha perdido la conexión."
msgstr "遊戲結束了：房主離開了，或者連線中斷了。"

#. Key:	ListStale
#. SourceLocation:	Source/Tortunabo/Private/Multiplayer/MP_GameInstance.cpp(1973)
#: Source/Tortunabo/Private/Multiplayer/MP_GameInstance.cpp(1973)
msgctxt "TNRooms,ListStale"
msgid "Esa sala ya no está en la lista: actualízala."
msgstr "那個房間已不在清單裡了，請重新整理。"

#. Key:	ListLocked
#. SourceLocation:	Source/Tortunabo/Private/Multiplayer/MP_GameInstance.cpp(1981)
#: Source/Tortunabo/Private/Multiplayer/MP_GameInstance.cpp(1981)
msgctxt "TNRooms,ListLocked"
msgid "«{0}» está cerrada: el anfitrión no deja entrar a nadie más."
msgstr "「{0}」已關閉：房主不再讓別人進來。"

#. Key:	ListFull
#. SourceLocation:	Source/Tortunabo/Private/Multiplayer/MP_GameInstance.cpp(1987)
#: Source/Tortunabo/Private/Multiplayer/MP_GameInstance.cpp(1987)
msgctxt "TNRooms,ListFull"
msgid "«{0}» está llena ({1}/{2})."
msgstr "「{0}」已額滿（{1}/{2}）。"

#. Key:	CodeIncomplete
#. SourceLocation:	Source/Tortunabo/Private/Multiplayer/MP_GameInstance.cpp(2005)
#: Source/Tortunabo/Private/Multiplayer/MP_GameInstance.cpp(2005)
msgctxt "TNRooms,CodeIncomplete"
msgid "El código tiene 5 letras y números (nunca lleva O, 0, I, 1 ni L)."
msgstr "代碼由 5 個字母和數字組成（不含 O、0、I、1 和 L）。"

#. Key:	CodeSearching
#. SourceLocation:	Source/Tortunabo/Private/Multiplayer/MP_GameInstance.cpp(2008)
#: Source/Tortunabo/Private/Multiplayer/MP_GameInstance.cpp(2008)
msgctxt "TNRooms,CodeSearching"
msgid "Buscando la sala {0}..."
msgstr "正在尋找房間 {0}……"

#. Key:	Locked
#. SourceLocation:	Source/Tortunabo/Private/Multiplayer/MP_GameInstance.cpp(2263)
#: Source/Tortunabo/Private/Multiplayer/MP_GameInstance.cpp(2263)
msgctxt "TNRooms,Locked"
msgid "Sala cerrada: no entra nadie más (los que ya estaban pueden volver)."
msgstr "房間已關閉：不再接納新人（已經在裡面的人可以重新進入）。"

#. Key:	Unlocked
#. SourceLocation:	Source/Tortunabo/Private/Multiplayer/MP_GameInstance.cpp(2264)
#: Source/Tortunabo/Private/Multiplayer/MP_GameInstance.cpp(2264)
msgctxt "TNRooms,Unlocked"
msgid "Sala abierta: puede entrar gente otra vez."
msgstr "房間已開放：又可以進人了。"

#. Key:	KickReason
#. SourceLocation:	Source/Tortunabo/Private/Multiplayer/MP_GameInstance.cpp(2302)
#: Source/Tortunabo/Private/Multiplayer/MP_GameInstance.cpp(2302)
msgctxt "TNRooms,KickReason"
msgid "El anfitrión te ha expulsado de la sala."
msgstr "房主把你踢出了房間。"

#. Key:	KickedNotice
#. SourceLocation:	Source/Tortunabo/Private/Multiplayer/MP_GameInstance.cpp(2319)
#: Source/Tortunabo/Private/Multiplayer/MP_GameInstance.cpp(2319)
