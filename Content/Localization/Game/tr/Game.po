msgid "Buggy de Serie"
msgstr "Standart Buggy"

#. Key:	BuggyModelStockDesc
#. SourceLocation:	Source/Tortunabo/Private/Vehicles/TN_BuggyCosmetics.cpp(50)
#: Source/Tortunabo/Private/Vehicles/TN_BuggyCosmetics.cpp(50)
msgctxt "Tortunabo,BuggyModelStockDesc"
