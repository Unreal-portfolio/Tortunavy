msgid "Desactivado"
msgstr "关闭"

#. Key:	VRModeSim
#. SourceLocation:	Source/Tortunabo/Private/UI/Pause/TN_PauseMenuWidget.cpp(2666)
#: Source/Tortunabo/Private/UI/Pause/TN_PauseMenuWidget.cpp(2666)
msgctxt "TNPause,VRModeSim"
msgid "Simulado sin gafas"
msgstr "无头显模拟"

#. Key:	VRMode
#. SourceLocation:	Source/Tortunabo/Private/UI/Pause/TN_PauseMenuWidget.cpp(2667)
#: Source/Tortunabo/Private/UI/Pause/TN_PauseMenuWidget.cpp(2667)
msgctxt "TNPause,VRMode"
msgid "Modo VR"
msgstr "VR 模式"

#. Key:	VRModeDesc
#. SourceLocation:	Source/Tortunabo/Private/UI/Pause/TN_PauseMenuWidget.cpp(2671)
#: Source/Tortunabo/Private/UI/Pause/TN_PauseMenuWidget.cpp(2671)
msgctxt "TNPause,VRModeDesc"
msgid "Automático: en primera persona con las gafas si el juego arranca con ellas (-vr o «VR Preview»). Desactivado: con gafas, la pantalla plana de siempre. Simulado: el modo VR sin gafas, con el ratón como aleta, para probarlo en el PC."
msgstr "自动：如果游戏带着头显启动（-vr 或“VR Preview”），就用头显以第一人称游玩。关闭：即使有头显，也用一贯的平面屏幕。模拟：没有头显的 VR 模式，把鼠标当作鳍，方便在电脑上试玩。"

#. Key:	VRTurn30
#. SourceLocation:	Source/Tortunabo/Private/UI/Pause/TN_PauseMenuWidget.cpp(2676)
#: Source/Tortunabo/Private/UI/Pause/TN_PauseMenuWidget.cpp(2676)
