#: Source/Tortunabo/Private/UI/Pause/TN_PauseMenuWidget.cpp(2694)
msgctxt "TNLocal,ResetGameGuestDesc"
msgid "Temblor de cámara encendido y campo de visión de siempre (solo los tuyos)."
msgstr "开启镜头抖动，视野恢复一贯的设置（仅限你自己的）。"

#. Key:	ResetGameDesc
#. SourceLocation:	Source/Tortunabo/Private/UI/Pause/TN_PauseMenuWidget.cpp(2695)
#: Source/Tortunabo/Private/UI/Pause/TN_PauseMenuWidget.cpp(2695)
msgctxt "TNPause,ResetGameDesc"
msgid "Temblor de cámara y ojo de pez encendidos, campo de visión e interfaz de siempre, sin filtro de color, sin «Quién habla», el idioma de tu sistema, la cámara en tercera persona y el modo VR automático con giro a pasos de 30°."
msgstr "镜头晃动和鱼眼开启，视野和界面大小恢复默认，关闭色盲滤镜和「谁在说话」，语言跟随你的系统，镜头为第三人称，VR 模式为自动、转向每次 30°。"

#. Key:	ResetAll
#. SourceLocation:	Source/Tortunabo/Private/UI/Pause/TN_PauseMenuWidget.cpp(2699)
#: Source/Tortunabo/Private/UI/Pause/TN_PauseMenuWidget.cpp(2699)
msgctxt "TNPause,ResetAll"
msgid "Restablecer todos los ajustes"
msgstr "重置所有设置"

#. Key:	ResetAllTitle
#. SourceLocation:	Source/Tortunabo/Private/UI/Pause/TN_PauseMenuWidget.cpp(2706)
#: Source/Tortunabo/Private/UI/Pause/TN_PauseMenuWidget.cpp(2706)
