msgstr "今日命令：{0} · {1}"

#. Key:	BriefingSayMissionChanged
#. SourceLocation:	Source/Tortunabo/Private/UI/Briefing/TN_BriefingWidget.cpp(777)
#: Source/Tortunabo/Private/UI/Briefing/TN_BriefingWidget.cpp(777)
msgctxt "Tortunabo,BriefingSayMissionChanged"
msgid "¡Atención, tropa! Nueva orden del día: {0}, dificultad {1}."
msgstr "全体注意！新的今日命令：{0}，难度{1}。"

#. Key:	BriefingSayHostOnly
#. SourceLocation:	Source/Tortunabo/Private/UI/Briefing/TN_BriefingWidget.cpp(787)
#: Source/Tortunabo/Private/UI/Briefing/TN_BriefingWidget.cpp(787)
msgctxt "Tortunabo,BriefingSayHostOnly"
msgid "¡Alto ahí, recluta! La misión la decide el anfitrión."
msgstr "站住，新兵！任务由房主决定。"

#. Key:	BriefingOrderEasy
#. SourceLocation:	Source/Tortunabo/Private/UI/Briefing/TN_BriefingWidget.cpp(79)
#: Source/Tortunabo/Private/UI/Briefing/TN_BriefingWidget.cpp(79)
msgctxt "Tortunabo,BriefingOrderEasy"
msgid "Fácil: un paseo por la playa para calentar las aletas."
msgstr "简单：沙滩散步，给鳍热热身。"

#. Key:	BriefingOrderHard
#. SourceLocation:	Source/Tortunabo/Private/UI/Briefing/TN_BriefingWidget.cpp(80)
