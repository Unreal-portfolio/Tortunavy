#: Source/Tortunabo/Private/UI/Pause/TN_PauseMenuWidget.cpp(2678)
msgctxt "TNPause,VRTurn"
msgid "Giro en VR"
msgstr "VR 转向"

#. Key:	VRTurnDesc
#. SourceLocation:	Source/Tortunabo/Private/UI/Pause/TN_PauseMenuWidget.cpp(2682)
#: Source/Tortunabo/Private/UI/Pause/TN_PauseMenuWidget.cpp(2682)
msgctxt "TNPause,VRTurnDesc"
msgid "Cómo gira la tortuga con el stick derecho. A pasos marea mucho menos; suave, para quien ya está acostumbrado."
msgstr "乌龟用右摇杆转向的方式。分步转向晕得少得多；平滑适合已经习惯的人。"

#. Key:	ResetGame
#. SourceLocation:	Source/Tortunabo/Private/UI/Pause/TN_PauseMenuWidget.cpp(2689)
#: Source/Tortunabo/Private/UI/Pause/TN_PauseMenuWidget.cpp(2689)
