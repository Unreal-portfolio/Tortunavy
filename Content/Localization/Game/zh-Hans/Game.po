msgid "Saltar (en el aire, otra vez: panzazo)"
msgstr "跳跃（空中再按：肚皮飞扑）"

#. Key:	CtlSprint
#. SourceLocation:	Source/Tortunabo/Private/UI/Briefing/TN_BriefingWidget.cpp(519)
