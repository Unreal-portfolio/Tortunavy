#. Key:	Arrival3c
#. SourceLocation:	Source/Tortunabo/Private/UI/Race/TN_RaceArrivalWidget.cpp(100)
#: Source/Tortunabo/Private/UI/Race/TN_RaceArrivalWidget.cpp(100)
msgctxt "TNRace,Arrival3c"
msgid "Tercera: corona de bolsillo, sonrisa de campeona."
msgstr "Третье место: карманная корона, улыбка чемпионки."

#. Key:	Arrival4a
#. SourceLocation:	Source/Tortunabo/Private/UI/Race/TN_RaceArrivalWidget.cpp(103)
#: Source/Tortunabo/Private/UI/Race/TN_RaceArrivalWidget.cpp(103)
msgctxt "TNRace,Arrival4a"
msgid "Cuarta. El cubo también es un trono… de arena."
msgstr "Четвёртое место. Ведро — тоже трон… песочный."

#. Key:	Arrival4b
#. SourceLocation:	Source/Tortunabo/Private/UI/Race/TN_RaceArrivalWidget.cpp(104)
#: Source/Tortunabo/Private/UI/Race/TN_RaceArrivalWidget.cpp(104)
msgctxt "TNRace,Arrival4b"
msgid "Cuarta. A un paso del podio, con un cubo de sombrero."
msgstr "Четвёртое место. Шаг до пьедестала, а вместо шляпы на голове ведро."

#. Key:	Arrival4c
#. SourceLocation:	Source/Tortunabo/Private/UI/Race/TN_RaceArrivalWidget.cpp(105)
#: Source/Tortunabo/Private/UI/Race/TN_RaceArrivalWidget.cpp(105)
msgctxt "TNRace,Arrival4c"
msgid "Cuarta. Si entornas los ojos, el cubo casi parece una corona."
msgstr "Четвёртое место. Если прищуриться, ведро почти как корона."

#. Key:	Arrival5a
#. SourceLocation:	Source/Tortunabo/Private/UI/Race/TN_RaceArrivalWidget.cpp(108)
#: Source/Tortunabo/Private/UI/Race/TN_RaceArrivalWidget.cpp(108)
msgctxt "TNRace,Arrival5a"
msgid "Quinta. Ni frío ni calor: templadita."
msgstr "Пятое место. Ни холодно ни жарко: тепленько."

#. Key:	Arrival5b
#. SourceLocation:	Source/Tortunabo/Private/UI/Race/TN_RaceArrivalWidget.cpp(109)
#: Source/Tortunabo/Private/UI/Race/TN_RaceArrivalWidget.cpp(109)
msgctxt "TNRace,Arrival5b"
msgid "Quinta. Media concha rota, medio aplauso."
msgstr "Пятое место. Половинка ракушки — половина аплодисментов."

#. Key:	Arrival5c
#. SourceLocation:	Source/Tortunabo/Private/UI/Race/TN_RaceArrivalWidget.cpp(110)
#: Source/Tortunabo/Private/UI/Race/TN_RaceArrivalWidget.cpp(110)
msgctxt "TNRace,Arrival5c"
msgid "Quinta. Justo en el medio, donde nadie mira."
msgstr "Пятое место. Ровно посередине, куда никто не смотрит."

#. Key:	Arrival6a
#. SourceLocation:	Source/Tortunabo/Private/UI/Race/TN_RaceArrivalWidget.cpp(113)
#: Source/Tortunabo/Private/UI/Race/TN_RaceArrivalWidget.cpp(113)
msgctxt "TNRace,Arrival6a"
msgid "Sexta. Hasta el flotador se rindió antes que tú."
msgstr "Шестое место. Даже надувной круг сдался раньше тебя."

#. Key:	Arrival6b
#. SourceLocation:	Source/Tortunabo/Private/UI/Race/TN_RaceArrivalWidget.cpp(114)
#: Source/Tortunabo/Private/UI/Race/TN_RaceArrivalWidget.cpp(114)
msgctxt "TNRace,Arrival6b"
msgid "Sexta. Llegas desinflada, como tu premio."
msgstr "Шестое место. Финиш такой же сдутый, как и твой приз."

#. Key:	Arrival6c
#. SourceLocation:	Source/Tortunabo/Private/UI/Race/TN_RaceArrivalWidget.cpp(115)
#: Source/Tortunabo/Private/UI/Race/TN_RaceArrivalWidget.cpp(115)
msgctxt "TNRace,Arrival6c"
msgid "Sexta. Psssss… eso que se escapa es tu orgullo."
msgstr "Шестое место. Пшшшш… это утекает твоя гордость."

#. Key:	Arrival7a
#. SourceLocation:	Source/Tortunabo/Private/UI/Race/TN_RaceArrivalWidget.cpp(118)
#: Source/Tortunabo/Private/UI/Race/TN_RaceArrivalWidget.cpp(118)
msgctxt "TNRace,Arrival7a"
msgid "Séptima. El gusano ya había reservado mesa."
msgstr "Седьмое место. Червь уже забронировал столик."

#. Key:	Arrival7b
#. SourceLocation:	Source/Tortunabo/Private/UI/Race/TN_RaceArrivalWidget.cpp(119)
#: Source/Tortunabo/Private/UI/Race/TN_RaceArrivalWidget.cpp(119)
msgctxt "TNRace,Arrival7b"
msgid "Séptima. Tu premio huele igual que tu carrera."
msgstr "Седьмое место. Приз пахнет так же, как твоя гонка."

#. Key:	Arrival7c
#. SourceLocation:	Source/Tortunabo/Private/UI/Race/TN_RaceArrivalWidget.cpp(120)
#: Source/Tortunabo/Private/UI/Race/TN_RaceArrivalWidget.cpp(120)
msgctxt "TNRace,Arrival7c"
msgid "Séptima. Un calcetín con arena: útil para… nada."
msgstr "Седьмое место. Носок с песком: годится… ни на что."

#. Key:	Arrival8a
#. SourceLocation:	Source/Tortunabo/Private/UI/Race/TN_RaceArrivalWidget.cpp(123)
#: Source/Tortunabo/Private/UI/Race/TN_RaceArrivalWidget.cpp(123)
msgctxt "TNRace,Arrival8a"
msgid "Octava. Las gaviotas ya te llaman por tu nombre."
msgstr "Восьмое место. Чайки уже зовут тебя по имени."

#. Key:	Arrival8b
#. SourceLocation:	Source/Tortunabo/Private/UI/Race/TN_RaceArrivalWidget.cpp(124)
#: Source/Tortunabo/Private/UI/Race/TN_RaceArrivalWidget.cpp(124)
msgctxt "TNRace,Arrival8b"
msgid "Octava. Te has traído medio mar enganchado a la cabeza."
msgstr "Восьмое место. Полморя зацепилось за твою голову."

#. Key:	Arrival8c
#. SourceLocation:	Source/Tortunabo/Private/UI/Race/TN_RaceArrivalWidget.cpp(125)
#: Source/Tortunabo/Private/UI/Race/TN_RaceArrivalWidget.cpp(125)
msgctxt "TNRace,Arrival8c"
msgid "Octava. Última, pero has llegado. Poca cosa, pero algo."
msgstr "Восьмое место. Последнее, но доползла. Немного, но всё же."

#. Key:	Prize1
#. SourceLocation:	Source/Tortunabo/Private/UI/Race/TN_RaceArrivalWidget.cpp(133)
#: Source/Tortunabo/Private/UI/Race/TN_RaceArrivalWidget.cpp(133)
msgctxt "TNRace,Prize1"
msgid "Corona de oro"
msgstr "Золотая корона"

#. Key:	Prize2
#. SourceLocation:	Source/Tortunabo/Private/UI/Race/TN_RaceArrivalWidget.cpp(134)
#: Source/Tortunabo/Private/UI/Race/TN_RaceArrivalWidget.cpp(134)
msgctxt "TNRace,Prize2"
msgid "Corona de plata"
msgstr "Серебряная корона"

#. Key:	Prize3
#. SourceLocation:	Source/Tortunabo/Private/UI/Race/TN_RaceArrivalWidget.cpp(135)
#: Source/Tortunabo/Private/UI/Race/TN_RaceArrivalWidget.cpp(135)
msgctxt "TNRace,Prize3"
msgid "Corona de bronce (talla mini)"
msgstr "Бронзовая корона (размер мини)"

#. Key:	Prize4
#. SourceLocation:	Source/Tortunabo/Private/UI/Race/TN_RaceArrivalWidget.cpp(136)
#: Source/Tortunabo/Private/UI/Race/TN_RaceArrivalWidget.cpp(136)
msgctxt "TNRace,Prize4"
msgid "Cubo de playa (del revés)"
msgstr "Пляжное ведро (вверх дном)"

#. Key:	Prize5
#. SourceLocation:	Source/Tortunabo/Private/UI/Race/TN_RaceArrivalWidget.cpp(137)
#: Source/Tortunabo/Private/UI/Race/TN_RaceArrivalWidget.cpp(137)
msgctxt "TNRace,Prize5"
msgid "Media concha rota"
msgstr "Половинка сломанной ракушки"

#. Key:	Prize6
#. SourceLocation:	Source/Tortunabo/Private/UI/Race/TN_RaceArrivalWidget.cpp(138)
#: Source/Tortunabo/Private/UI/Race/TN_RaceArrivalWidget.cpp(138)
msgctxt "TNRace,Prize6"
msgid "Flotador pinchado"
msgstr "Проколотый надувной круг"

#. Key:	Prize7
#. SourceLocation:	Source/Tortunabo/Private/UI/Race/TN_RaceArrivalWidget.cpp(139)
#: Source/Tortunabo/Private/UI/Race/TN_RaceArrivalWidget.cpp(139)
msgctxt "TNRace,Prize7"
msgid "Calcetín mojado con arena"
msgstr "Мокрый носок с песком"

#. Key:	Prize8
#. SourceLocation:	Source/Tortunabo/Private/UI/Race/TN_RaceArrivalWidget.cpp(140)
#: Source/Tortunabo/Private/UI/Race/TN_RaceArrivalWidget.cpp(140)
msgctxt "TNRace,Prize8"
msgid "Alga de peluca"
msgstr "Водоросль вместо парика"

#. Key:	ArrivalHead
#. SourceLocation:	Source/Tortunabo/Private/UI/Race/TN_RaceArrivalWidget.cpp(175)
#: Source/Tortunabo/Private/UI/Race/TN_RaceArrivalWidget.cpp(175)
msgctxt "TNRace,ArrivalHead"
msgid "HAS QUEDADO"
msgstr "ТВОЁ МЕСТО"

#. Key:	Preview
#. SourceLocation:	Source/Tortunabo/Private/UI/Race/TN_RaceArrivalWidget.cpp(206)
#: Source/Tortunabo/Private/UI/Race/TN_RaceArrivalWidget.cpp(206)
msgctxt "TNRace,Preview"
msgid "VISTA PREVIA"
msgstr "ПРЕДПРОСМОТР"

#. Key:	ArrivalSprint
#. SourceLocation:	Source/Tortunabo/Private/UI/Race/TN_RaceArrivalWidget.cpp(230)
#: Source/Tortunabo/Private/UI/Race/TN_RaceArrivalWidget.cpp(230)
msgctxt "TNRace,ArrivalSprint"
msgid "SPRINT FINAL"
msgstr "ФИНАЛЬНЫЙ СПРИНТ"

#. Key:	ArrivalRound
#. SourceLocation:	Source/Tortunabo/Private/UI/Race/TN_RaceArrivalWidget.cpp(231)
#: Source/Tortunabo/Private/UI/Race/TN_RaceArrivalWidget.cpp(231)
