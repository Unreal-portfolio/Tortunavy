msgid "Coger a una tortuga"
msgstr "Поднять черепашку"

#. Key:	TitleEscape
#. SourceLocation:	Source/Tortunabo/Private/Lobby/TN_TutorialTexts.h(32)
#: Source/Tortunabo/Private/Lobby/TN_TutorialTexts.h(32)
