msgid "¡Se te oye!"
msgstr "Тебя слышно!"

#. Key:	Quiet
#. SourceLocation:	Source/Tortunabo/Private/UI/Pause/TN_PauseMenuWidget.cpp(2394)
#: Source/Tortunabo/Private/UI/Pause/TN_PauseMenuWidget.cpp(2394)
