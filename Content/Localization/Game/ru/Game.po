msgid "¡Difícil! Solo para veteranas con el caparazón bien duro."
msgstr "Сложная! Только для ветеранов с очень крепким панцирем."

#. Key:	BriefingOrderNormal
#. SourceLocation:	Source/Tortunabo/Private/UI/Briefing/TN_BriefingWidget.cpp(81)
#: Source/Tortunabo/Private/UI/Briefing/TN_BriefingWidget.cpp(81)
