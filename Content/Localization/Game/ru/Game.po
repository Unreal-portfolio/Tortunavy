#: Source/Tortunabo/Private/UI/Pause/TN_PauseMenuWidget.cpp(2318)
msgctxt "TNPause,PushToTalk"
msgid "Pulsar para hablar"
msgstr "Нажми и говори"

#. Key:	MicMode
