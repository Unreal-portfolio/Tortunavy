msgid "RONDA {0}"
msgstr "РАУНД {0}"

#. Key:	ArrivalPlace
#. SourceLocation:	Source/Tortunabo/Private/UI/Race/TN_RaceArrivalWidget.cpp(236)
#: Source/Tortunabo/Private/UI/Race/TN_RaceArrivalWidget.cpp(236)
msgctxt "TNRace,ArrivalPlace"
msgid "{0}.º"
msgstr "{0}-е"

#. Key:	Arrival1a
#. SourceLocation:	Source/Tortunabo/Private/UI/Race/TN_RaceArrivalWidget.cpp(87)
#: Source/Tortunabo/Private/UI/Race/TN_RaceArrivalWidget.cpp(87)
msgctxt "TNRace,Arrival1a"
msgid "¡Reina de la playa! Hasta las gaviotas te hacen reverencias."
msgstr "Королева пляжа! Даже чайки тебе кланяются."

#. Key:	Arrival1b
#. SourceLocation:	Source/Tortunabo/Private/UI/Race/TN_RaceArrivalWidget.cpp(88)
#: Source/Tortunabo/Private/UI/Race/TN_RaceArrivalWidget.cpp(88)
msgctxt "TNRace,Arrival1b"
msgid "¡Primera! El mar te esperaba con la alfombra de espuma puesta."
msgstr "Первое место! Море уже расстелило для тебя пенную ковровую дорожку."

#. Key:	Arrival1c
#. SourceLocation:	Source/Tortunabo/Private/UI/Race/TN_RaceArrivalWidget.cpp(89)
#: Source/Tortunabo/Private/UI/Race/TN_RaceArrivalWidget.cpp(89)
msgctxt "TNRace,Arrival1c"
msgid "¡Oro! Los cangrejos ya están tallando tu estatua de arena."
msgstr "Золото! Крабы уже лепят твою статую из песка."

#. Key:	Arrival1d
#. SourceLocation:	Source/Tortunabo/Private/UI/Race/TN_RaceArrivalWidget.cpp(90)
#: Source/Tortunabo/Private/UI/Race/TN_RaceArrivalWidget.cpp(90)
msgctxt "TNRace,Arrival1d"
msgid "¡Nadie te ha visto ni la cola! Esa corona te queda de miedo."
msgstr "Никто даже хвоста твоего не видел! Эта корона тебе безумно идёт."

#. Key:	Arrival2a
#. SourceLocation:	Source/Tortunabo/Private/UI/Race/TN_RaceArrivalWidget.cpp(93)
#: Source/Tortunabo/Private/UI/Race/TN_RaceArrivalWidget.cpp(93)
msgctxt "TNRace,Arrival2a"
msgid "¡Casi! La arena aún quema de tus pasos."
msgstr "Почти! Песок ещё дымится от твоих следов."

#. Key:	Arrival2b
#. SourceLocation:	Source/Tortunabo/Private/UI/Race/TN_RaceArrivalWidget.cpp(94)
#: Source/Tortunabo/Private/UI/Race/TN_RaceArrivalWidget.cpp(94)
msgctxt "TNRace,Arrival2b"
msgid "¡Plata! A un aletazo del oro: la próxima es tuya."
msgstr "Серебро! До золота один взмах ластой: в следующий раз оно твоё."

#. Key:	Arrival2c
#. SourceLocation:	Source/Tortunabo/Private/UI/Race/TN_RaceArrivalWidget.cpp(95)
#: Source/Tortunabo/Private/UI/Race/TN_RaceArrivalWidget.cpp(95)
msgctxt "TNRace,Arrival2c"
msgid "¡Segunda y brillando! Hasta el sol se ha puesto celoso."
msgstr "Второе место, и как сияешь! Даже солнце заревновало."

#. Key:	Arrival3a
#. SourceLocation:	Source/Tortunabo/Private/UI/Race/TN_RaceArrivalWidget.cpp(98)
#: Source/Tortunabo/Private/UI/Race/TN_RaceArrivalWidget.cpp(98)
msgctxt "TNRace,Arrival3a"
msgid "Podio. La corona es pequeña; el orgullo, no."
msgstr "Пьедестал. Корона маленькая, а гордость — нет."

#. Key:	Arrival3b
#. SourceLocation:	Source/Tortunabo/Private/UI/Race/TN_RaceArrivalWidget.cpp(99)
#: Source/Tortunabo/Private/UI/Race/TN_RaceArrivalWidget.cpp(99)
msgctxt "TNRace,Arrival3b"
msgid "¡Bronce! Te cabe en una aleta, pero es toda tuya."
msgstr "Бронза! Влезает в одну ласту, зато целиком твоя."

#. Key:	ChampionTitle
#. SourceLocation:	Source/Tortunabo/Private/UI/Race/TN_RaceChampionWidget.cpp(173)
#: Source/Tortunabo/Private/UI/Race/TN_RaceChampionWidget.cpp(173)
msgctxt "TNRace,ChampionTitle"
msgid "¡CAMPEONA DE LA PLAYA!"
msgstr "ЧЕМПИОНКА ПЛЯЖА!"

#. Key:	ChampionSubtitle
#. SourceLocation:	Source/Tortunabo/Private/UI/Race/TN_RaceChampionWidget.cpp(210)
#: Source/Tortunabo/Private/UI/Race/TN_RaceChampionWidget.cpp(210)
msgctxt "TNRace,ChampionSubtitle"
msgid "¡Se lleva la partida!"
msgstr "Забирает партию!"

#. Key:	PlayAgain
