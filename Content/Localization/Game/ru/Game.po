#. Key:	Helmet_Captain_Description
#. SourceLocation:	/Game/Blueprints/Gameplay/Cosmetics/DT_Helmets.DT_Helmets.Helmet_Captain.Description
#: /Game/Blueprints/Gameplay/Cosmetics/DT_Helmets.DT_Helmets.Helmet_Captain.Description
msgctxt "DT_Helmets,Helmet_Captain_Description"
msgid "Para quien lleva el timón de la tripulación."
msgstr "Для того, кто держит штурвал команды."

#. Key:	Helmet_Captain_DisplayName
#. SourceLocation:	/Game/Blueprints/Gameplay/Cosmetics/DT_Helmets.DT_Helmets.Helmet_Captain.DisplayName
#: /Game/Blueprints/Gameplay/Cosmetics/DT_Helmets.DT_Helmets.Helmet_Captain.DisplayName
msgctxt "DT_Helmets,Helmet_Captain_DisplayName"
msgid "Gorra de capitán"
msgstr "Капитанская фуражка"

#. Key:	Helmet_Crab_Description
#. SourceLocation:	/Game/Blueprints/Gameplay/Cosmetics/DT_Helmets.DT_Helmets.Helmet_Crab.Description
#: /Game/Blueprints/Gameplay/Cosmetics/DT_Helmets.DT_Helmets.Helmet_Crab.Description
msgctxt "DT_Helmets,Helmet_Crab_Description"
msgid "Te acompaña a todas partes y te defiende de las gaviotas."
msgstr "Ходит за тобой повсюду и защищает от чаек."

#. Key:	Helmet_Crab_DisplayName
#. SourceLocation:	/Game/Blueprints/Gameplay/Cosmetics/DT_Helmets.DT_Helmets.Helmet_Crab.DisplayName
#: /Game/Blueprints/Gameplay/Cosmetics/DT_Helmets.DT_Helmets.Helmet_Crab.DisplayName
msgctxt "DT_Helmets,Helmet_Crab_DisplayName"
msgid "Cangrejo de compañía"
msgstr "Краб-компаньон"

#. Key:	Helmet_Crown_Description
#. SourceLocation:	/Game/Blueprints/Gameplay/Cosmetics/DT_Helmets.DT_Helmets.Helmet_Crown.Description
#: /Game/Blueprints/Gameplay/Cosmetics/DT_Helmets.DT_Helmets.Helmet_Crown.Description
msgctxt "DT_Helmets,Helmet_Crown_Description"
msgid "Oro de verdad. Bueno, de verdad de la buena no, pero brilla igual."
msgstr "Настоящее золото. Ну, не совсем настоящее, зато блестит не хуже."

#. Key:	Helmet_Crown_DisplayName
#. SourceLocation:	/Game/Blueprints/Gameplay/Cosmetics/DT_Helmets.DT_Helmets.Helmet_Crown.DisplayName
#: /Game/Blueprints/Gameplay/Cosmetics/DT_Helmets.DT_Helmets.Helmet_Crown.DisplayName
msgctxt "DT_Helmets,Helmet_Crown_DisplayName"
msgid "Corona real"
msgstr "Королевская корона"

#. Key:	Helmet_Halo_Description
#. SourceLocation:	/Game/Blueprints/Gameplay/Cosmetics/DT_Helmets.DT_Helmets.Helmet_Halo.Description
#: /Game/Blueprints/Gameplay/Cosmetics/DT_Helmets.DT_Helmets.Helmet_Halo.Description
msgctxt "DT_Helmets,Helmet_Halo_Description"
msgid "Para las tortugas más buenas del arrecife."
msgstr "Для самых пай-черепашек рифа."

#. Key:	Helmet_Halo_DisplayName
#. SourceLocation:	/Game/Blueprints/Gameplay/Cosmetics/DT_Helmets.DT_Helmets.Helmet_Halo.DisplayName
#: /Game/Blueprints/Gameplay/Cosmetics/DT_Helmets.DT_Helmets.Helmet_Halo.DisplayName
msgctxt "DT_Helmets,Helmet_Halo_DisplayName"
msgid "Aureola"
msgstr "Нимб"

#. Key:	Helmet_Hibiscus_Description
#. SourceLocation:	/Game/Blueprints/Gameplay/Cosmetics/DT_Helmets.DT_Helmets.Helmet_Hibiscus.Description
#: /Game/Blueprints/Gameplay/Cosmetics/DT_Helmets.DT_Helmets.Helmet_Hibiscus.Description
msgctxt "DT_Helmets,Helmet_Hibiscus_Description"
msgid "Un hibisco recién cogido. Huele a vacaciones."
msgstr "Свежесорванный гибискус. Пахнет отпуском."

#. Key:	Helmet_Hibiscus_DisplayName
#. SourceLocation:	/Game/Blueprints/Gameplay/Cosmetics/DT_Helmets.DT_Helmets.Helmet_Hibiscus.DisplayName
#: /Game/Blueprints/Gameplay/Cosmetics/DT_Helmets.DT_Helmets.Helmet_Hibiscus.DisplayName
msgctxt "DT_Helmets,Helmet_Hibiscus_DisplayName"
msgid "Flor tropical"
msgstr "Тропический цветок"

#. Key:	Helmet_Jelly_Description
#. SourceLocation:	/Game/Blueprints/Gameplay/Cosmetics/DT_Helmets.DT_Helmets.Helmet_Jelly.Description
#: /Game/Blueprints/Gameplay/Cosmetics/DT_Helmets.DT_Helmets.Helmet_Jelly.Description
msgctxt "DT_Helmets,Helmet_Jelly_Description"
msgid "Blandito y fresquito. No pica, te lo prometo."
msgstr "Мягонькая и прохладная. Не жжётся, обещаю."

#. Key:	Helmet_Jelly_DisplayName
#. SourceLocation:	/Game/Blueprints/Gameplay/Cosmetics/DT_Helmets.DT_Helmets.Helmet_Jelly.DisplayName
#: /Game/Blueprints/Gameplay/Cosmetics/DT_Helmets.DT_Helmets.Helmet_Jelly.DisplayName
msgctxt "DT_Helmets,Helmet_Jelly_DisplayName"
msgid "Sombrero medusa"
msgstr "Шляпа-медуза"

#. Key:	Helmet_Party_Description
#. SourceLocation:	/Game/Blueprints/Gameplay/Cosmetics/DT_Helmets.DT_Helmets.Helmet_Party.Description
#: /Game/Blueprints/Gameplay/Cosmetics/DT_Helmets.DT_Helmets.Helmet_Party.Description
msgctxt "DT_Helmets,Helmet_Party_Description"
msgid "¡Toda carrera terminada es motivo de celebración!"
msgstr "Любой финиш — повод для праздника!"

#. Key:	Helmet_Party_DisplayName
#. SourceLocation:	/Game/Blueprints/Gameplay/Cosmetics/DT_Helmets.DT_Helmets.Helmet_Party.DisplayName
#: /Game/Blueprints/Gameplay/Cosmetics/DT_Helmets.DT_Helmets.Helmet_Party.DisplayName
msgctxt "DT_Helmets,Helmet_Party_DisplayName"
msgid "Gorro de fiesta"
msgstr "Праздничный колпак"

#. Key:	Helmet_Pirate_Description
#. SourceLocation:	/Game/Blueprints/Gameplay/Cosmetics/DT_Helmets.DT_Helmets.Helmet_Pirate.Description
#: /Game/Blueprints/Gameplay/Cosmetics/DT_Helmets.DT_Helmets.Helmet_Pirate.Description
msgctxt "DT_Helmets,Helmet_Pirate_Description"
msgid "Perteneció a un capitán muy temido... o eso me dijeron."
msgstr "Принадлежала грозному капитану… по крайней мере, мне так сказали."

#. Key:	Helmet_Pirate_DisplayName
#. SourceLocation:	/Game/Blueprints/Gameplay/Cosmetics/DT_Helmets.DT_Helmets.Helmet_Pirate.DisplayName
#: /Game/Blueprints/Gameplay/Cosmetics/DT_Helmets.DT_Helmets.Helmet_Pirate.DisplayName
msgctxt "DT_Helmets,Helmet_Pirate_DisplayName"
msgid "Tricornio pirata"
msgstr "Пиратская треуголка"

#. Key:	Helmet_Propeller_Description
#. SourceLocation:	/Game/Blueprints/Gameplay/Cosmetics/DT_Helmets.DT_Helmets.Helmet_Propeller.Description
#: /Game/Blueprints/Gameplay/Cosmetics/DT_Helmets.DT_Helmets.Helmet_Propeller.Description
msgctxt "DT_Helmets,Helmet_Propeller_Description"
msgid "No vuela. Lo he probado. Pero queda genial."
msgstr "Не летает. Проверено. Зато выглядит круто."

#. Key:	Helmet_Propeller_DisplayName
#. SourceLocation:	/Game/Blueprints/Gameplay/Cosmetics/DT_Helmets.DT_Helmets.Helmet_Propeller.DisplayName
#: /Game/Blueprints/Gameplay/Cosmetics/DT_Helmets.DT_Helmets.Helmet_Propeller.DisplayName
msgctxt "DT_Helmets,Helmet_Propeller_DisplayName"
msgid "Gorro de hélice"
msgstr "Шапка с пропеллером"

#. Key:	Helmet_Sailor_Description
#. SourceLocation:	/Game/Blueprints/Gameplay/Cosmetics/DT_Helmets.DT_Helmets.Helmet_Sailor.Description
#: /Game/Blueprints/Gameplay/Cosmetics/DT_Helmets.DT_Helmets.Helmet_Sailor.Description
msgctxt "DT_Helmets,Helmet_Sailor_Description"
msgid "Con pompón rojo y cintas al viento. Muy marinero."
msgstr "С красным помпоном и ленточками по ветру. Настоящий морячок."

#. Key:	Helmet_Sailor_DisplayName
#. SourceLocation:	/Game/Blueprints/Gameplay/Cosmetics/DT_Helmets.DT_Helmets.Helmet_Sailor.DisplayName
#: /Game/Blueprints/Gameplay/Cosmetics/DT_Helmets.DT_Helmets.Helmet_Sailor.DisplayName
msgctxt "DT_Helmets,Helmet_Sailor_DisplayName"
msgid "Gorro de marinero"
msgstr "Бескозырка"

#. Key:	Helmet_Starfish_Description
#. SourceLocation:	/Game/Blueprints/Gameplay/Cosmetics/DT_Helmets.DT_Helmets.Helmet_Starfish.Description
#: /Game/Blueprints/Gameplay/Cosmetics/DT_Helmets.DT_Helmets.Helmet_Starfish.Description
msgctxt "DT_Helmets,Helmet_Starfish_Description"
msgid "Se llama Estrellita. Es muy tranquila, no muerde."
msgstr "Её зовут Звёздочка. Очень спокойная, не кусается."

#. Key:	Helmet_Starfish_DisplayName
#. SourceLocation:	/Game/Blueprints/Gameplay/Cosmetics/DT_Helmets.DT_Helmets.Helmet_Starfish.DisplayName
#: /Game/Blueprints/Gameplay/Cosmetics/DT_Helmets.DT_Helmets.Helmet_Starfish.DisplayName
msgctxt "DT_Helmets,Helmet_Starfish_DisplayName"
msgid "Estrella de mar"
msgstr "Морская звезда"

#. Key:	Helmet_Straw_Description
#. SourceLocation:	/Game/Blueprints/Gameplay/Cosmetics/DT_Helmets.DT_Helmets.Helmet_Straw.Description
#: /Game/Blueprints/Gameplay/Cosmetics/DT_Helmets.DT_Helmets.Helmet_Straw.Description
msgctxt "DT_Helmets,Helmet_Straw_Description"
msgid "Fresquito para la playa. Con lazo coral, que es lo que se lleva."
msgstr "Прохладная шляпа для пляжа. С коралловой лентой — сейчас это модно."

#. Key:	Helmet_Straw_DisplayName
#. SourceLocation:	/Game/Blueprints/Gameplay/Cosmetics/DT_Helmets.DT_Helmets.Helmet_Straw.DisplayName
#: /Game/Blueprints/Gameplay/Cosmetics/DT_Helmets.DT_Helmets.Helmet_Straw.DisplayName
msgctxt "DT_Helmets,Helmet_Straw_DisplayName"
msgid "Sombrero de paja"
msgstr "Соломенная шляпа"

#. Key:	Body_Bubblegum_Description
#. SourceLocation:	/Game/Blueprints/Gameplay/Cosmetics/DT_Skins.DT_Skins.Body_Bubblegum.Description
#: /Game/Blueprints/Gameplay/Cosmetics/DT_Skins.DT_Skins.Body_Bubblegum.Description
msgctxt "DT_Skins,Body_Bubblegum_Description"
msgid "Rosa chicle con la barriga de nata. Muy dulce."
msgstr "Розовая жвачка с кремовым брюшком. Сладкая-пресладкая."

#. Key:	Body_Bubblegum_DisplayName
#. SourceLocation:	/Game/Blueprints/Gameplay/Cosmetics/DT_Skins.DT_Skins.Body_Bubblegum.DisplayName
#: /Game/Blueprints/Gameplay/Cosmetics/DT_Skins.DT_Skins.Body_Bubblegum.DisplayName
msgctxt "DT_Skins,Body_Bubblegum_DisplayName"
msgid "Rosa chicle"
msgstr "Розовая жвачка"

#. Key:	Body_Charcoal_Description
#. SourceLocation:	/Game/Blueprints/Gameplay/Cosmetics/DT_Skins.DT_Skins.Body_Charcoal.Description
#: /Game/Blueprints/Gameplay/Cosmetics/DT_Skins.DT_Skins.Body_Charcoal.Description
msgctxt "DT_Skins,Body_Charcoal_Description"
msgid "Gris carbón con la barriga plateada. Misteriosa."
msgstr "Угольно-серая с серебристым брюшком. Загадочная."

#. Key:	Body_Charcoal_DisplayName
#. SourceLocation:	/Game/Blueprints/Gameplay/Cosmetics/DT_Skins.DT_Skins.Body_Charcoal.DisplayName
#: /Game/Blueprints/Gameplay/Cosmetics/DT_Skins.DT_Skins.Body_Charcoal.DisplayName
msgctxt "DT_Skins,Body_Charcoal_DisplayName"
msgid "Carbón"
msgstr "Уголь"

#. Key:	Body_Coral_Description
#. SourceLocation:	/Game/Blueprints/Gameplay/Cosmetics/DT_Skins.DT_Skins.Body_Coral.Description
#: /Game/Blueprints/Gameplay/Cosmetics/DT_Skins.DT_Skins.Body_Coral.Description
msgctxt "DT_Skins,Body_Coral_Description"
msgid "Rojo coral, el color de los valientes del arrecife."
msgstr "Коралловый красный — цвет храбрецов рифа."

#. Key:	Body_Coral_DisplayName
#. SourceLocation:	/Game/Blueprints/Gameplay/Cosmetics/DT_Skins.DT_Skins.Body_Coral.DisplayName
#: /Game/Blueprints/Gameplay/Cosmetics/DT_Skins.DT_Skins.Body_Coral.DisplayName
msgctxt "DT_Skins,Body_Coral_DisplayName"
msgid "Rojo coral"
msgstr "Коралловый красный"

#. Key:	Body_Forest_Description
#. SourceLocation:	/Game/Blueprints/Gameplay/Cosmetics/DT_Skins.DT_Skins.Body_Forest.Description
#: /Game/Blueprints/Gameplay/Cosmetics/DT_Skins.DT_Skins.Body_Forest.Description
msgctxt "DT_Skins,Body_Forest_Description"
msgid "Verde oscuro de la selva profunda."
msgstr "Тёмно-зелёный цвет дремучих джунглей."

#. Key:	Body_Forest_DisplayName
#. SourceLocation:	/Game/Blueprints/Gameplay/Cosmetics/DT_Skins.DT_Skins.Body_Forest.DisplayName
#: /Game/Blueprints/Gameplay/Cosmetics/DT_Skins.DT_Skins.Body_Forest.DisplayName
msgctxt "DT_Skins,Body_Forest_DisplayName"
msgid "Verde bosque"
msgstr "Лесной зелёный"

#. Key:	Body_Lavender_Description
#. SourceLocation:	/Game/Blueprints/Gameplay/Cosmetics/DT_Skins.DT_Skins.Body_Lavender.Description
#: /Game/Blueprints/Gameplay/Cosmetics/DT_Skins.DT_Skins.Body_Lavender.Description
msgctxt "DT_Skins,Body_Lavender_Description"
msgid "Morado lavanda: huele a playa tranquila."
msgstr "Лавандовый фиолетовый: пахнет тихим пляжем."

#. Key:	Body_Lavender_DisplayName
#. SourceLocation:	/Game/Blueprints/Gameplay/Cosmetics/DT_Skins.DT_Skins.Body_Lavender.DisplayName
#: /Game/Blueprints/Gameplay/Cosmetics/DT_Skins.DT_Skins.Body_Lavender.DisplayName
msgctxt "DT_Skins,Body_Lavender_DisplayName"
msgid "Lavanda"
msgstr "Лаванда"

#. Key:	Body_Lime_Description
#. SourceLocation:	/Game/Blueprints/Gameplay/Cosmetics/DT_Skins.DT_Skins.Body_Lime.Description
#: /Game/Blueprints/Gameplay/Cosmetics/DT_Skins.DT_Skins.Body_Lime.Description
msgctxt "DT_Skins,Body_Lime_Description"
msgid "Verde lima, ácido y veloz."
msgstr "Зелёный лайм: кислый и быстрый."

#. Key:	Body_Lime_DisplayName
#. SourceLocation:	/Game/Blueprints/Gameplay/Cosmetics/DT_Skins.DT_Skins.Body_Lime.DisplayName
#: /Game/Blueprints/Gameplay/Cosmetics/DT_Skins.DT_Skins.Body_Lime.DisplayName
msgctxt "DT_Skins,Body_Lime_DisplayName"
msgid "Lima"
msgstr "Лайм"

#. Key:	Body_Mint_Description
#. SourceLocation:	/Game/Blueprints/Gameplay/Cosmetics/DT_Skins.DT_Skins.Body_Mint.Description
#: /Game/Blueprints/Gameplay/Cosmetics/DT_Skins.DT_Skins.Body_Mint.Description
msgctxt "DT_Skins,Body_Mint_Description"
msgid "Menta fresquita para los días de calor."
msgstr "Свежая мята для жарких дней."

#. Key:	Body_Mint_DisplayName
#. SourceLocation:	/Game/Blueprints/Gameplay/Cosmetics/DT_Skins.DT_Skins.Body_Mint.DisplayName
#: /Game/Blueprints/Gameplay/Cosmetics/DT_Skins.DT_Skins.Body_Mint.DisplayName
msgctxt "DT_Skins,Body_Mint_DisplayName"
msgid "Menta"
msgstr "Мята"

#. Key:	Body_Ocean_Description
#. SourceLocation:	/Game/Blueprints/Gameplay/Cosmetics/DT_Skins.DT_Skins.Body_Ocean.Description
#: /Game/Blueprints/Gameplay/Cosmetics/DT_Skins.DT_Skins.Body_Ocean.Description
msgctxt "DT_Skins,Body_Ocean_Description"
msgid "Del color del mar abierto. Te camuflas al nadar."
msgstr "Цвета открытого моря. Когда плывёшь, тебя не заметить."

#. Key:	Body_Ocean_DisplayName
#. SourceLocation:	/Game/Blueprints/Gameplay/Cosmetics/DT_Skins.DT_Skins.Body_Ocean.DisplayName
#: /Game/Blueprints/Gameplay/Cosmetics/DT_Skins.DT_Skins.Body_Ocean.DisplayName
msgctxt "DT_Skins,Body_Ocean_DisplayName"
msgid "Azul océano"
msgstr "Синий океан"

#. Key:	Body_Orange_Description
#. SourceLocation:	/Game/Blueprints/Gameplay/Cosmetics/DT_Skins.DT_Skins.Body_Orange.Description
#: /Game/Blueprints/Gameplay/Cosmetics/DT_Skins.DT_Skins.Body_Orange.Description
msgctxt "DT_Skins,Body_Orange_Description"
msgid "Naranja atardecer. Combina con todo."
msgstr "Оранжевый, как закат. Подходит ко всему."

#. Key:	Body_Orange_DisplayName
#. SourceLocation:	/Game/Blueprints/Gameplay/Cosmetics/DT_Skins.DT_Skins.Body_Orange.DisplayName
#: /Game/Blueprints/Gameplay/Cosmetics/DT_Skins.DT_Skins.Body_Orange.DisplayName
msgctxt "DT_Skins,Body_Orange_DisplayName"
msgid "Naranja"
msgstr "Оранжевый"

#. Key:	Body_Sand_Description
#. SourceLocation:	/Game/Blueprints/Gameplay/Cosmetics/DT_Skins.DT_Skins.Body_Sand.Description
#: /Game/Blueprints/Gameplay/Cosmetics/DT_Skins.DT_Skins.Body_Sand.Description
msgctxt "DT_Skins,Body_Sand_Description"
msgid "Color arena de playa. Es el que llevo yo, ¿se nota?"
msgstr "Цвет пляжного песка. Я тоже такой, заметно?"

#. Key:	Body_Sand_DisplayName
#. SourceLocation:	/Game/Blueprints/Gameplay/Cosmetics/DT_Skins.DT_Skins.Body_Sand.DisplayName
#: /Game/Blueprints/Gameplay/Cosmetics/DT_Skins.DT_Skins.Body_Sand.DisplayName
msgctxt "DT_Skins,Body_Sand_DisplayName"
msgid "Arena"
msgstr "Песок"

#. Key:	Body_Snow_Description
#. SourceLocation:	/Game/Blueprints/Gameplay/Cosmetics/DT_Skins.DT_Skins.Body_Snow.Description
#: /Game/Blueprints/Gameplay/Cosmetics/DT_Skins.DT_Skins.Body_Snow.Description
msgctxt "DT_Skins,Body_Snow_Description"
msgid "Blanco nieve. Muy elegante, pero no te revuelques en la arena."
msgstr "Белый, как снег. Очень элегантно, только не валяйся в песке."

#. Key:	Body_Snow_DisplayName
#. SourceLocation:	/Game/Blueprints/Gameplay/Cosmetics/DT_Skins.DT_Skins.Body_Snow.DisplayName
#: /Game/Blueprints/Gameplay/Cosmetics/DT_Skins.DT_Skins.Body_Snow.DisplayName
msgctxt "DT_Skins,Body_Snow_DisplayName"
msgid "Blanco nieve"
msgstr "Белоснежный"

#. Key:	Body_Sunny_Description
#. SourceLocation:	/Game/Blueprints/Gameplay/Cosmetics/DT_Skins.DT_Skins.Body_Sunny.Description
#: /Game/Blueprints/Gameplay/Cosmetics/DT_Skins.DT_Skins.Body_Sunny.Description
msgctxt "DT_Skins,Body_Sunny_Description"
msgid "Amarillo como el sol de mediodía. Se te ve desde lejos."
msgstr "Жёлтый, как полуденное солнце. Тебя видно издалека."

#. Key:	Body_Sunny_DisplayName
#. SourceLocation:	/Game/Blueprints/Gameplay/Cosmetics/DT_Skins.DT_Skins.Body_Sunny.DisplayName
#: /Game/Blueprints/Gameplay/Cosmetics/DT_Skins.DT_Skins.Body_Sunny.DisplayName
msgctxt "DT_Skins,Body_Sunny_DisplayName"
msgid "Amarillo sol"
msgstr "Солнечный жёлтый"

#. Key:	Eyes_Cat_Description
#. SourceLocation:	/Game/Blueprints/Gameplay/Cosmetics/DT_Skins.DT_Skins.Eyes_Cat.Description
#: /Game/Blueprints/Gameplay/Cosmetics/DT_Skins.DT_Skins.Eyes_Cat.Description
msgctxt "DT_Skins,Eyes_Cat_Description"
msgid "Pupila de rendija. Ven en la oscuridad... o eso dicen."
msgstr "Зрачок-щёлочка. В темноте видят… так говорят."

#. Key:	Eyes_Cat_DisplayName
#. SourceLocation:	/Game/Blueprints/Gameplay/Cosmetics/DT_Skins.DT_Skins.Eyes_Cat.DisplayName
#: /Game/Blueprints/Gameplay/Cosmetics/DT_Skins.DT_Skins.Eyes_Cat.DisplayName
msgctxt "DT_Skins,Eyes_Cat_DisplayName"
msgid "Ojos de gato"
msgstr "Кошачьи глаза"

#. Key:	Eyes_Emerald_Description
#. SourceLocation:	/Game/Blueprints/Gameplay/Cosmetics/DT_Skins.DT_Skins.Eyes_Emerald.Description
#: /Game/Blueprints/Gameplay/Cosmetics/DT_Skins.DT_Skins.Eyes_Emerald.Description
msgctxt "DT_Skins,Eyes_Emerald_Description"
msgid "Verdes como la selva después de la lluvia."
msgstr "Зелёные, как джунгли после дождя."

#. Key:	Eyes_Emerald_DisplayName
#. SourceLocation:	/Game/Blueprints/Gameplay/Cosmetics/DT_Skins.DT_Skins.Eyes_Emerald.DisplayName
#: /Game/Blueprints/Gameplay/Cosmetics/DT_Skins.DT_Skins.Eyes_Emerald.DisplayName
msgctxt "DT_Skins,Eyes_Emerald_DisplayName"
msgid "Iris esmeralda"
msgstr "Изумрудные глаза"

#. Key:	Eyes_Galaxy_Description
#. SourceLocation:	/Game/Blueprints/Gameplay/Cosmetics/DT_Skins.DT_Skins.Eyes_Galaxy.Description
#: /Game/Blueprints/Gameplay/Cosmetics/DT_Skins.DT_Skins.Eyes_Galaxy.Description
msgctxt "DT_Skins,Eyes_Galaxy_Description"
msgid "Un universo entero en cada ojo. Brillan en la oscuridad."
msgstr "Целая вселенная в каждом глазу. Светятся в темноте."

#. Key:	Eyes_Galaxy_DisplayName
#. SourceLocation:	/Game/Blueprints/Gameplay/Cosmetics/DT_Skins.DT_Skins.Eyes_Galaxy.DisplayName
#: /Game/Blueprints/Gameplay/Cosmetics/DT_Skins.DT_Skins.Eyes_Galaxy.DisplayName
msgctxt "DT_Skins,Eyes_Galaxy_DisplayName"
msgid "Galaxia"
msgstr "Галактика"

#. Key:	Eyes_Heart_Description
#. SourceLocation:	/Game/Blueprints/Gameplay/Cosmetics/DT_Skins.DT_Skins.Eyes_Heart.Description
#: /Game/Blueprints/Gameplay/Cosmetics/DT_Skins.DT_Skins.Eyes_Heart.Description
msgctxt "DT_Skins,Eyes_Heart_Description"
msgid "Enamorada del mar, de la playa y de ganar."
msgstr "Влюблена в море, в пляж и в победы."

#. Key:	Eyes_Heart_DisplayName
#. SourceLocation:	/Game/Blueprints/Gameplay/Cosmetics/DT_Skins.DT_Skins.Eyes_Heart.DisplayName
#: /Game/Blueprints/Gameplay/Cosmetics/DT_Skins.DT_Skins.Eyes_Heart.DisplayName
msgctxt "DT_Skins,Eyes_Heart_DisplayName"
msgid "Pupilas de corazón"
msgstr "Зрачки-сердечки"

#. Key:	Eyes_Honey_Description
#. SourceLocation:	/Game/Blueprints/Gameplay/Cosmetics/DT_Skins.DT_Skins.Eyes_Honey.Description
#: /Game/Blueprints/Gameplay/Cosmetics/DT_Skins.DT_Skins.Eyes_Honey.Description
msgctxt "DT_Skins,Eyes_Honey_Description"
msgid "Color miel: cálidos y dulces."
msgstr "Медового цвета: тёплые и сладкие."

