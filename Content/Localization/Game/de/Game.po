msgid "No hay conexión con Steam: ábrelo y vuelve a intentarlo."
msgstr "Keine Verbindung zu Steam: Öffne es und versuche es noch mal."

#. Key:	CreateFailed
#. SourceLocation:	Source/Tortunabo/Private/Multiplayer/MP_GameInstance.cpp(740)
#: Source/Tortunabo/Private/Multiplayer/MP_GameInstance.cpp(740)
msgctxt "TNRooms,CreateFailed"
msgid "No se ha podido crear la sala. ¿Está Steam abierto y conectado?"
msgstr "Der Raum konnte nicht erstellt werden. Ist Steam geöffnet und verbunden?"

#. Key:	SearchFailed
#. SourceLocation:	Source/Tortunabo/Private/Multiplayer/MP_GameInstance.cpp(846)
#: Source/Tortunabo/Private/Multiplayer/MP_GameInstance.cpp(846)
