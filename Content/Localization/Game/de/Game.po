msgid "El menú de pausa"
msgstr "Das Pausenmenü"

#. Key:	TitleWaterfall
#. SourceLocation:	Source/Tortunabo/Private/Lobby/TN_TutorialTexts.h(36)
#: Source/Tortunabo/Private/Lobby/TN_TutorialTexts.h(36)
