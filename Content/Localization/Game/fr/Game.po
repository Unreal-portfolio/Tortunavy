msgid "Soltar el objeto (o a quien llevas)"
msgstr "Lâcher l’objet (ou qui tu portes)"

#. Key:	CtlRotate
#. SourceLocation:	Source/Tortunabo/Private/UI/Briefing/TN_BriefingWidget.cpp(526)
