#. Key:	Arrival3c
#. SourceLocation:	Source/Tortunabo/Private/UI/Race/TN_RaceArrivalWidget.cpp(100)
#: Source/Tortunabo/Private/UI/Race/TN_RaceArrivalWidget.cpp(100)
msgctxt "TNRace,Arrival3c"
msgid "Tercera: corona de bolsillo, sonrisa de campeona."
msgstr "Troisième : couronne de poche, sourire de championne."

#. Key:	Arrival4a
#. SourceLocation:	Source/Tortunabo/Private/UI/Race/TN_RaceArrivalWidget.cpp(103)
#: Source/Tortunabo/Private/UI/Race/TN_RaceArrivalWidget.cpp(103)
msgctxt "TNRace,Arrival4a"
msgid "Cuarta. El cubo también es un trono… de arena."
msgstr "Quatrième. Un seau, ça peut aussi faire un trône... de sable."

#. Key:	Arrival4b
#. SourceLocation:	Source/Tortunabo/Private/UI/Race/TN_RaceArrivalWidget.cpp(104)
#: Source/Tortunabo/Private/UI/Race/TN_RaceArrivalWidget.cpp(104)
msgctxt "TNRace,Arrival4b"
msgid "Cuarta. A un paso del podio, con un cubo de sombrero."
msgstr "Quatrième. À un pas du podium, avec un seau en guise de chapeau."

#. Key:	Arrival4c
#. SourceLocation:	Source/Tortunabo/Private/UI/Race/TN_RaceArrivalWidget.cpp(105)
#: Source/Tortunabo/Private/UI/Race/TN_RaceArrivalWidget.cpp(105)
msgctxt "TNRace,Arrival4c"
msgid "Cuarta. Si entornas los ojos, el cubo casi parece una corona."
msgstr "Quatrième. Si tu plisses les yeux, le seau ressemble presque à une couronne."

#. Key:	Arrival5a
#. SourceLocation:	Source/Tortunabo/Private/UI/Race/TN_RaceArrivalWidget.cpp(108)
#: Source/Tortunabo/Private/UI/Race/TN_RaceArrivalWidget.cpp(108)
msgctxt "TNRace,Arrival5a"
msgid "Quinta. Ni frío ni calor: templadita."
msgstr "Cinquième. Ni chaud ni froid : tiède."

#. Key:	Arrival5b
#. SourceLocation:	Source/Tortunabo/Private/UI/Race/TN_RaceArrivalWidget.cpp(109)
#: Source/Tortunabo/Private/UI/Race/TN_RaceArrivalWidget.cpp(109)
msgctxt "TNRace,Arrival5b"
msgid "Quinta. Media concha rota, medio aplauso."
msgstr "Cinquième. Un demi-coquillage brisé, une demi-salve d’applaudissements."

#. Key:	Arrival5c
#. SourceLocation:	Source/Tortunabo/Private/UI/Race/TN_RaceArrivalWidget.cpp(110)
#: Source/Tortunabo/Private/UI/Race/TN_RaceArrivalWidget.cpp(110)
msgctxt "TNRace,Arrival5c"
msgid "Quinta. Justo en el medio, donde nadie mira."
msgstr "Cinquième. Pile au milieu, là où personne ne regarde."

#. Key:	Arrival6a
#. SourceLocation:	Source/Tortunabo/Private/UI/Race/TN_RaceArrivalWidget.cpp(113)
#: Source/Tortunabo/Private/UI/Race/TN_RaceArrivalWidget.cpp(113)
