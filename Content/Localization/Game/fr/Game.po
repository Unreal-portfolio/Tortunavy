msgid "Séptima. El gusano ya había reservado mesa."
msgstr "Septième. Le ver avait déjà réservé sa table."

#. Key:	Arrival7b
#. SourceLocation:	Source/Tortunabo/Private/UI/Race/TN_RaceArrivalWidget.cpp(119)
#: Source/Tortunabo/Private/UI/Race/TN_RaceArrivalWidget.cpp(119)
msgctxt "TNRace,Arrival7b"
msgid "Séptima. Tu premio huele igual que tu carrera."
msgstr "Septième. Ton prix sent comme ta course."

#. Key:	Arrival7c
#. SourceLocation:	Source/Tortunabo/Private/UI/Race/TN_RaceArrivalWidget.cpp(120)
#: Source/Tortunabo/Private/UI/Race/TN_RaceArrivalWidget.cpp(120)
msgctxt "TNRace,Arrival7c"
msgid "Séptima. Un calcetín con arena: útil para… nada."
msgstr "Septième. Une chaussette pleine de sable : utile pour... rien."

#. Key:	Arrival8a
#. SourceLocation:	Source/Tortunabo/Private/UI/Race/TN_RaceArrivalWidget.cpp(123)
#: Source/Tortunabo/Private/UI/Race/TN_RaceArrivalWidget.cpp(123)
msgctxt "TNRace,Arrival8a"
msgid "Octava. Las gaviotas ya te llaman por tu nombre."
msgstr "Huitième. Les mouettes t’appellent déjà par ton prénom."

#. Key:	Arrival8b
#. SourceLocation:	Source/Tortunabo/Private/UI/Race/TN_RaceArrivalWidget.cpp(124)
#: Source/Tortunabo/Private/UI/Race/TN_RaceArrivalWidget.cpp(124)
msgctxt "TNRace,Arrival8b"
msgid "Octava. Te has traído medio mar enganchado a la cabeza."
msgstr "Huitième. Tu as ramené la moitié de la mer accrochée à la tête."

#. Key:	Arrival8c
#. SourceLocation:	Source/Tortunabo/Private/UI/Race/TN_RaceArrivalWidget.cpp(125)
#: Source/Tortunabo/Private/UI/Race/TN_RaceArrivalWidget.cpp(125)
msgctxt "TNRace,Arrival8c"
msgid "Octava. Última, pero has llegado. Poca cosa, pero algo."
msgstr "Huitième. Dernière, mais tu es arrivée. Pas grand-chose, mais c’est quelque chose."

