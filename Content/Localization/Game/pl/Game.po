#. SourceLocation:	/Game/Blueprints/Gameplay/Cosmetics/DT_Helmets.DT_Helmets.Helmet_Hibiscus.Description
#: /Game/Blueprints/Gameplay/Cosmetics/DT_Helmets.DT_Helmets.Helmet_Hibiscus.Description
msgctxt "DT_Helmets,Helmet_Hibiscus_Description"
msgid "Un hibisco recién cogido. Huele a vacaciones."
msgstr "Świeżo zerwany hibiskus. Pachnie wakacjami."

