msgid "Bailes y frases"
msgstr "Tańce i frazy"

#. Key:	TitleVoice
#. SourceLocation:	Source/Tortunabo/Private/Lobby/TN_TutorialTexts.h(34)
#: Source/Tortunabo/Private/Lobby/TN_TutorialTexts.h(34)
msgctxt "TNTutorial,TitleVoice"
msgid "Tu voz"
msgstr "Twój głos"

#. Key:	TitlePause
#. SourceLocation:	Source/Tortunabo/Private/Lobby/TN_TutorialTexts.h(35)
#: Source/Tortunabo/Private/Lobby/TN_TutorialTexts.h(35)
msgctxt "TNTutorial,TitlePause"
msgid "El menú de pausa"
msgstr "Menu pauzy"

#. Key:	TitleWaterfall
#. SourceLocation:	Source/Tortunabo/Private/Lobby/TN_TutorialTexts.h(36)
#: Source/Tortunabo/Private/Lobby/TN_TutorialTexts.h(36)
msgctxt "TNTutorial,TitleWaterfall"
msgid "¡Al castillo!"
msgstr "Do zamku!"

#. Key:	TaskMove
#. SourceLocation:	Source/Tortunabo/Private/Lobby/TN_TutorialTexts.h(46)
#: Source/Tortunabo/Private/Lobby/TN_TutorialTexts.h(46)
msgctxt "TNTutorial,TaskMove"
msgid "Muévete"
msgstr "Ruszaj się"

#. Key:	TaskLook
#. SourceLocation:	Source/Tortunabo/Private/Lobby/TN_TutorialTexts.h(47)
#: Source/Tortunabo/Private/Lobby/TN_TutorialTexts.h(47)
msgctxt "TNTutorial,TaskLook"
msgid "Mira alrededor"
msgstr "Rozejrzyj się"

#. Key:	TaskSprint
#. SourceLocation:	Source/Tortunabo/Private/Lobby/TN_TutorialTexts.h(48)
#: Source/Tortunabo/Private/Lobby/TN_TutorialTexts.h(48)
msgctxt "TNTutorial,TaskSprint"
msgid "Mantén para correr"
msgstr "Przytrzymaj, by biec"

#. Key:	TaskJump
#. SourceLocation:	Source/Tortunabo/Private/Lobby/TN_TutorialTexts.h(49)
#: Source/Tortunabo/Private/Lobby/TN_TutorialTexts.h(49)
msgctxt "TNTutorial,TaskJump"
msgid "Salta al escalón"
msgstr "Wskocz na stopień"

#. Key:	TaskDive
#. SourceLocation:	Source/Tortunabo/Private/Lobby/TN_TutorialTexts.h(50)
#: Source/Tortunabo/Private/Lobby/TN_TutorialTexts.h(50)
msgctxt "TNTutorial,TaskDive"
msgid "En el aire, pulsa otra vez: te tiras en plancha"
msgstr "W powietrzu naciśnij jeszcze raz: rzucisz się na brzuch"

#. Key:	TaskPickup
#. SourceLocation:	Source/Tortunabo/Private/Lobby/TN_TutorialTexts.h(51)
#: Source/Tortunabo/Private/Lobby/TN_TutorialTexts.h(51)
msgctxt "TNTutorial,TaskPickup"
msgid "Coge la barrita de energía"
msgstr "Podnieś batonik energetyczny"

#. Key:	TaskSearch
#. SourceLocation:	Source/Tortunabo/Private/Lobby/TN_TutorialTexts.h(52)
#: Source/Tortunabo/Private/Lobby/TN_TutorialTexts.h(52)
msgctxt "TNTutorial,TaskSearch"
msgid "Mantén junto al montículo y coge lo que salga"
msgstr "Przytrzymaj przy kopcu i weź, co wypadnie"

#. Key:	TaskSwap
#. SourceLocation:	Source/Tortunabo/Private/Lobby/TN_TutorialTexts.h(54)
#: Source/Tortunabo/Private/Lobby/TN_TutorialTexts.h(54)
msgctxt "TNTutorial,TaskSwap"
msgid "Cambia lo de la aleta por lo del caparazón"
msgstr "Zamień to, co w płetwie, na to, co w pancerzu"

#. Key:	TaskDrop
#. SourceLocation:	Source/Tortunabo/Private/Lobby/TN_TutorialTexts.h(55)
#: Source/Tortunabo/Private/Lobby/TN_TutorialTexts.h(55)
msgctxt "TNTutorial,TaskDrop"
msgid "Suelta lo de la aleta (y vuelve a cogerlo)"
msgstr "Upuść to, co w płetwie (i weź to znowu)"

#. Key:	TaskThrow
#. SourceLocation:	Source/Tortunabo/Private/Lobby/TN_TutorialTexts.h(56)
#: Source/Tortunabo/Private/Lobby/TN_TutorialTexts.h(56)
msgctxt "TNTutorial,TaskThrow"
msgid "Con la bola en la aleta, apunta con la cámara y dale al cangrejo"
msgstr "Z kulą w płetwie wyceluj kamerą i trafij kraba"

#. Key:	TaskUse
#. SourceLocation:	Source/Tortunabo/Private/Lobby/TN_TutorialTexts.h(57)
#: Source/Tortunabo/Private/Lobby/TN_TutorialTexts.h(57)
msgctxt "TNTutorial,TaskUse"
msgid "Usa la barrita y corre sin cansarte"
msgstr "Użyj batonika i biegaj bez zmęczenia"

#. Key:	TaskShellIn
#. SourceLocation:	Source/Tortunabo/Private/Lobby/TN_TutorialTexts.h(59)
#: Source/Tortunabo/Private/Lobby/TN_TutorialTexts.h(59)
msgctxt "TNTutorial,TaskShellIn"
msgid "Métete en el caparazón y rueda cuesta abajo"
msgstr "Schowaj się w pancerzu i stocz się w dół zbocza"

#. Key:	TaskShellOut
#. SourceLocation:	Source/Tortunabo/Private/Lobby/TN_TutorialTexts.h(60)
#: Source/Tortunabo/Private/Lobby/TN_TutorialTexts.h(60)
msgctxt "TNTutorial,TaskShellOut"
msgid "Sal con la misma tecla"
msgstr "Wyjdź tym samym klawiszem"

#. Key:	TaskTrampoline
#. SourceLocation:	Source/Tortunabo/Private/Lobby/TN_TutorialTexts.h(61)
#: Source/Tortunabo/Private/Lobby/TN_TutorialTexts.h(61)
msgctxt "TNTutorial,TaskTrampoline"
msgid "Salta encima de la medusa para subir a la roca"
msgstr "Wskocz na meduzę, by dostać się na skałę"

#. Key:	TaskCatapult
#. SourceLocation:	Source/Tortunabo/Private/Lobby/TN_TutorialTexts.h(62)
#: Source/Tortunabo/Private/Lobby/TN_TutorialTexts.h(62)
msgctxt "TNTutorial,TaskCatapult"
msgid "Métete en la cuchara, de pie o hecha bola, y vuela al otro lado"
msgstr "Wejdź na łyżkę, na stojąco lub w kuli, i przeleć na drugą stronę"

#. Key:	TaskSwim
#. SourceLocation:	Source/Tortunabo/Private/Lobby/TN_TutorialTexts.h(64)
#: Source/Tortunabo/Private/Lobby/TN_TutorialTexts.h(64)
msgctxt "TNTutorial,TaskSwim"
msgid "Cruza la laguna nadando"
msgstr "Przepłyń lagunę"

#. Key:	TaskSwimOut
#. SourceLocation:	Source/Tortunabo/Private/Lobby/TN_TutorialTexts.h(65)
#: Source/Tortunabo/Private/Lobby/TN_TutorialTexts.h(65)
msgctxt "TNTutorial,TaskSwimOut"
msgid "Salta para salir del agua"
msgstr "Skocz, by wyjść z wody"

#. Key:	TaskGrab
#. SourceLocation:	Source/Tortunabo/Private/Lobby/TN_TutorialTexts.h(67)
#: Source/Tortunabo/Private/Lobby/TN_TutorialTexts.h(67)
msgctxt "TNTutorial,TaskGrab"
msgid "Coge a Rodolfo, que está en su caparazón"
msgstr "Chwyć Rodolfa, który siedzi w pancerzu"

#. Key:	TaskToss
#. SourceLocation:	Source/Tortunabo/Private/Lobby/TN_TutorialTexts.h(68)
#: Source/Tortunabo/Private/Lobby/TN_TutorialTexts.h(68)
msgctxt "TNTutorial,TaskToss"
msgid "Lánzalo (o déjalo en el suelo con la tecla de soltar)"
msgstr "Rzuć go (albo połóż na ziemi klawiszem upuszczania)"

#. Key:	TaskGetGrabbed
#. SourceLocation:	Source/Tortunabo/Private/Lobby/TN_TutorialTexts.h(70)
#: Source/Tortunabo/Private/Lobby/TN_TutorialTexts.h(70)
msgctxt "TNTutorial,TaskGetGrabbed"
msgid "Métete en el caparazón junto a Berta: te cogerá"
msgstr "Schowaj się w pancerzu obok Berty: ona cię chwyci"

#. Key:	TaskStruggle
#. SourceLocation:	Source/Tortunabo/Private/Lobby/TN_TutorialTexts.h(71)
#: Source/Tortunabo/Private/Lobby/TN_TutorialTexts.h(71)
msgctxt "TNTutorial,TaskStruggle"
msgid "Muévete sin parar para soltarte"
msgstr "Ruszaj się bez przerwy, by się wyswobodzić"

#. Key:	TaskEmote
#. SourceLocation:	Source/Tortunabo/Private/Lobby/TN_TutorialTexts.h(73)
#: Source/Tortunabo/Private/Lobby/TN_TutorialTexts.h(73)
msgctxt "TNTutorial,TaskEmote"
msgid "Mantén, elige un baile y suelta"
msgstr "Przytrzymaj, wybierz taniec i puść"

#. Key:	TaskChat
#. SourceLocation:	Source/Tortunabo/Private/Lobby/TN_TutorialTexts.h(74)
#: Source/Tortunabo/Private/Lobby/TN_TutorialTexts.h(74)
msgctxt "TNTutorial,TaskChat"
msgid "Mantén, elige una frase y suelta"
msgstr "Przytrzymaj, wybierz frazę i puść"

#. Key:	TaskVoice
#. SourceLocation:	Source/Tortunabo/Private/Lobby/TN_TutorialTexts.h(75)
#: Source/Tortunabo/Private/Lobby/TN_TutorialTexts.h(75)
msgctxt "TNTutorial,TaskVoice"
msgid "Habla: te oyen las tortugas a menos de 25 m"
msgstr "Powiedz coś: słyszą cię żółwie w promieniu 25 m"

#. Key:	TaskPause
#. SourceLocation:	Source/Tortunabo/Private/Lobby/TN_TutorialTexts.h(76)
#: Source/Tortunabo/Private/Lobby/TN_TutorialTexts.h(76)
msgctxt "TNTutorial,TaskPause"
msgid "Abre el menú de pausa y mira los ajustes"
msgstr "Otwórz menu pauzy i zajrzyj do ustawień"

#. Key:	TaskWaterfall
#. SourceLocation:	Source/Tortunabo/Private/Lobby/TN_TutorialTexts.h(77)
#: Source/Tortunabo/Private/Lobby/TN_TutorialTexts.h(77)
msgctxt "TNTutorial,TaskWaterfall"
msgid "Salta por la cascada: caerás en el castillo"
msgstr "Skocz w wodospad: wylądujesz w zamku"

#. Key:	TipWelcome
#. SourceLocation:	Source/Tortunabo/Private/Lobby/TN_TutorialTexts.h(87)
#: Source/Tortunabo/Private/Lobby/TN_TutorialTexts.h(87)
msgctxt "TNTutorial,TipWelcome"
msgid "La tortuga va hacia donde mira la cámara. Sigue el camino: cada cartel te enseña una cosa."
msgstr "Żółw idzie tam, gdzie patrzy kamera. Idź ścieżką: każda tablica uczy czegoś nowego."

#. Key:	TipSprint
#. SourceLocation:	Source/Tortunabo/Private/Lobby/TN_TutorialTexts.h(89)
#: Source/Tortunabo/Private/Lobby/TN_TutorialTexts.h(89)
msgctxt "TNTutorial,TipSprint"
msgid "El salvavidas de abajo es tu energía: se gasta al correr y, si se vacía, jadeas hasta que se recarga."
msgstr "Koło ratunkowe na dole to twoja energia: zużywa się podczas biegu, a gdy się skończy, dyszysz, aż się naładuje."

#. Key:	TipJump
#. SourceLocation:	Source/Tortunabo/Private/Lobby/TN_TutorialTexts.h(91)
#: Source/Tortunabo/Private/Lobby/TN_TutorialTexts.h(91)
msgctxt "TNTutorial,TipJump"
msgid "Saltas algo más de un metro. Corriendo llegas más lejos."
msgstr "Skaczesz na nieco ponad metr. W biegu polecisz dalej."

#. Key:	TipDive
#. SourceLocation:	Source/Tortunabo/Private/Lobby/TN_TutorialTexts.h(93)
#: Source/Tortunabo/Private/Lobby/TN_TutorialTexts.h(93)
msgctxt "TNTutorial,TipDive"
msgid "Vuelas más lejos y resbalas por el suelo: sirve para cruzar huecos y esquivar la caca de gaviota. Muévete o salta para levantarte."
msgstr "Lecisz dalej i ślizgasz się po ziemi: przydaje się do przeskakiwania dziur i unikania mewich kup. Ruszaj się albo skacz, by wstać."

#. Key:	TipPickup
#. SourceLocation:	Source/Tortunabo/Private/Lobby/TN_TutorialTexts.h(95)
#: Source/Tortunabo/Private/Lobby/TN_TutorialTexts.h(95)
msgctxt "TNTutorial,TipPickup"
msgid "Lo que coges va a la aleta; si ya llevas algo, al caparazón. Todo pesa: con mucho encima te cansas antes."
msgstr "To, co podniesiesz, trafia do płetwy; jeśli już coś nosisz, do pancerza. Wszystko waży: z dużym ciężarem męczysz się szybciej."

#. Key:	TipSearch
#. SourceLocation:	Source/Tortunabo/Private/Lobby/TN_TutorialTexts.h(97)
#: Source/Tortunabo/Private/Lobby/TN_TutorialTexts.h(97)
msgctxt "TNTutorial,TipSearch"
msgid "Muchas rocas, estatuas y cajas del camino se pueden rebuscar igual: a veces sale algo."
msgstr "W wielu skałach, posągach i skrzyniach przy drodze też można poszperać: czasem coś z nich wypada."

#. Key:	TipSlots
#. SourceLocation:	Source/Tortunabo/Private/Lobby/TN_TutorialTexts.h(99)
#: Source/Tortunabo/Private/Lobby/TN_TutorialTexts.h(99)
msgctxt "TNTutorial,TipSlots"
msgid "Abajo, en el centro, ves lo que llevas: en la aleta y en el caparazón."
msgstr "Na dole, pośrodku, widzisz, co nosisz: w płetwie i w pancerzu."

#. Key:	Header
#. SourceLocation:	Source/Tortunabo/Private/Lobby/TN_TutorialWidget.cpp(232)
#: Source/Tortunabo/Private/Lobby/TN_TutorialWidget.cpp(232)
msgctxt "TNTutorial,Header"
msgid "TUTORIAL · {0} / {1}"
msgstr "SAMOUCZEK · {0} / {1}"

#. Key:	Connecting
#. SourceLocation:	Source/Tortunabo/Private/Multiplayer/MP_GameInstance.cpp(1010)
#: Source/Tortunabo/Private/Multiplayer/MP_GameInstance.cpp(1010)
msgctxt "TNRooms,Connecting"
msgid "Entrando en «{0}»..."
msgstr "Wchodzę do „{0}”..."

#. Key:	BuildMismatchStatus
#. SourceLocation:	Source/Tortunabo/Private/Multiplayer/MP_GameInstance.cpp(1861)
#: Source/Tortunabo/Private/Multiplayer/MP_GameInstance.cpp(1861)
msgctxt "TNRooms,BuildMismatchStatus"
msgid "Versiones incompatibles con el servidor."
msgstr "Wersja niezgodna z serwerem."

#. Key:	BuildMismatch
#. SourceLocation:	Source/Tortunabo/Private/Multiplayer/MP_GameInstance.cpp(1865)
#: Source/Tortunabo/Private/Multiplayer/MP_GameInstance.cpp(1865)
msgctxt "TNRooms,BuildMismatch"
msgid "Tu versión del juego no es la misma que la del anfitrión. Poneos los dos en la misma versión y volved a intentarlo."
msgstr "Twoja wersja gry nie jest taka sama jak gospodarza. Zainstalujcie obie tę samą wersję i spróbujcie ponownie."

#. Key:	ConnectFailed
#. SourceLocation:	Source/Tortunabo/Private/Multiplayer/MP_GameInstance.cpp(1923)
#: Source/Tortunabo/Private/Multiplayer/MP_GameInstance.cpp(1923)
msgctxt "TNRooms,ConnectFailed"
msgid "No se ha podido conectar con la sala: puede que el anfitrión se haya ido."
msgstr "Nie udało się połączyć z pokojem: gospodarz mógł wyjść."

#. Key:	HostLeft
#. SourceLocation:	Source/Tortunabo/Private/Multiplayer/MP_GameInstance.cpp(1924)
#: Source/Tortunabo/Private/Multiplayer/MP_GameInstance.cpp(1924)
msgctxt "TNRooms,HostLeft"
msgid "Se ha acabado la partida: el anfitrión se ha ido o se ha perdido la conexión."
msgstr "Gra dobiegła końca: gospodarz wyszedł albo zerwało się połączenie."

#. Key:	ListStale
#. SourceLocation:	Source/Tortunabo/Private/Multiplayer/MP_GameInstance.cpp(2054)
#: Source/Tortunabo/Private/Multiplayer/MP_GameInstance.cpp(2054)
msgctxt "TNRooms,ListStale"
msgid "Esa sala ya no está en la lista: actualízala."
msgstr "Tego pokoju nie ma już na liście: odśwież ją."

#. Key:	ListLocked
#. SourceLocation:	Source/Tortunabo/Private/Multiplayer/MP_GameInstance.cpp(2062)
#: Source/Tortunabo/Private/Multiplayer/MP_GameInstance.cpp(2062)
msgctxt "TNRooms,ListLocked"
msgid "«{0}» está cerrada: el anfitrión no deja entrar a nadie más."
msgstr "„{0}” jest zamknięty: gospodarz nikogo już nie wpuszcza."

#. Key:	ListFull
#. SourceLocation:	Source/Tortunabo/Private/Multiplayer/MP_GameInstance.cpp(2068)
#: Source/Tortunabo/Private/Multiplayer/MP_GameInstance.cpp(2068)
msgctxt "TNRooms,ListFull"
msgid "«{0}» está llena ({1}/{2})."
msgstr "„{0}” jest pełny ({1}/{2})."

#. Key:	CodeIncomplete
#. SourceLocation:	Source/Tortunabo/Private/Multiplayer/MP_GameInstance.cpp(2086)
#: Source/Tortunabo/Private/Multiplayer/MP_GameInstance.cpp(2086)
msgctxt "TNRooms,CodeIncomplete"
msgid "El código tiene 5 letras y números (nunca lleva O, 0, I, 1 ni L)."
msgstr "Kod ma 5 liter i cyfr (nigdy nie zawiera O, 0, I, 1 ani L)."

#. Key:	CodeSearching
#. SourceLocation:	Source/Tortunabo/Private/Multiplayer/MP_GameInstance.cpp(2089)
#: Source/Tortunabo/Private/Multiplayer/MP_GameInstance.cpp(2089)
msgctxt "TNRooms,CodeSearching"
msgid "Buscando la sala {0}..."
msgstr "Szukam pokoju {0}..."

#. Key:	Locked
#. SourceLocation:	Source/Tortunabo/Private/Multiplayer/MP_GameInstance.cpp(2346)
#: Source/Tortunabo/Private/Multiplayer/MP_GameInstance.cpp(2346)
msgctxt "TNRooms,Locked"
msgid "Sala cerrada: no entra nadie más (los que ya estaban pueden volver)."
msgstr "Pokój zamknięty: nikt nowy nie wejdzie (ci, którzy już byli, mogą wrócić)."

#. Key:	Unlocked
#. SourceLocation:	Source/Tortunabo/Private/Multiplayer/MP_GameInstance.cpp(2347)
#: Source/Tortunabo/Private/Multiplayer/MP_GameInstance.cpp(2347)
msgctxt "TNRooms,Unlocked"
msgid "Sala abierta: puede entrar gente otra vez."
msgstr "Pokój otwarty: znów można wchodzić."

#. Key:	KickReason
#. SourceLocation:	Source/Tortunabo/Private/Multiplayer/MP_GameInstance.cpp(2385)
#: Source/Tortunabo/Private/Multiplayer/MP_GameInstance.cpp(2385)
msgctxt "TNRooms,KickReason"
msgid "El anfitrión te ha expulsado de la sala."
msgstr "Gospodarz wyrzucił cię z pokoju."

#. Key:	KickedNotice
#. SourceLocation:	Source/Tortunabo/Private/Multiplayer/MP_GameInstance.cpp(2402)
#: Source/Tortunabo/Private/Multiplayer/MP_GameInstance.cpp(2402)
msgctxt "TNRooms,KickedNotice"
msgid "El anfitrión te ha expulsado de la sala «{0}»."
msgstr "Gospodarz wyrzucił cię z pokoju „{0}”."

#. Key:	CreatingRoom
#. SourceLocation:	Source/Tortunabo/Private/Multiplayer/MP_GameInstance.cpp(698)
#: Source/Tortunabo/Private/Multiplayer/MP_GameInstance.cpp(698)
msgctxt "TNRooms,CreatingRoom"
msgid "Creando la sala «{0}»..."
msgstr "Tworzę pokój „{0}”..."

#. Key:	NoOnline
#. SourceLocation:	Source/Tortunabo/Private/Multiplayer/MP_GameInstance.cpp(705)
#: Source/Tortunabo/Private/Multiplayer/MP_GameInstance.cpp(705)
msgctxt "TNRooms,NoOnline"
msgid "No hay conexión con Steam: ábrelo y vuelve a intentarlo."
msgstr "Brak połączenia ze Steamem: uruchom go i spróbuj ponownie."

#. Key:	CreateFailed
#. SourceLocation:	Source/Tortunabo/Private/Multiplayer/MP_GameInstance.cpp(779)
#: Source/Tortunabo/Private/Multiplayer/MP_GameInstance.cpp(779)
msgctxt "TNRooms,CreateFailed"
msgid "No se ha podido crear la sala. ¿Está Steam abierto y conectado?"
msgstr "Nie udało się utworzyć pokoju. Czy Steam jest włączony i połączony?"

#. Key:	SearchFailed
#. SourceLocation:	Source/Tortunabo/Private/Multiplayer/MP_GameInstance.cpp(885)
#: Source/Tortunabo/Private/Multiplayer/MP_GameInstance.cpp(885)
msgctxt "TNRooms,SearchFailed"
msgid "No se ha podido buscar salas. ¿Está Steam abierto y conectado?"
msgstr "Nie udało się wyszukać pokoi. Czy Steam jest włączony i połączony?"

#. Key:	CodeNotFound
#. SourceLocation:	Source/Tortunabo/Private/Multiplayer/MP_GameInstance.cpp(889)
#: Source/Tortunabo/Private/Multiplayer/MP_GameInstance.cpp(889)
msgctxt "TNRooms,CodeNotFound"
msgid "No hay ninguna sala con el código {0}. Revisa el código (con Steam, una sala llena tampoco aparece)."
msgstr "Nie ma pokoju o kodzie {0}. Sprawdź kod (przez Steam pełny pokój też się nie pokaże)."

#. Key:	CodeLocked
#. SourceLocation:	Source/Tortunabo/Private/Multiplayer/MP_GameInstance.cpp(897)
#: Source/Tortunabo/Private/Multiplayer/MP_GameInstance.cpp(897)
msgctxt "TNRooms,CodeLocked"
msgid "«{0}» está cerrada: el anfitrión no deja entrar a nadie más."
msgstr "„{0}” jest zamknięty: gospodarz nikogo już nie wpuszcza."

#. Key:	CodeFull
#. SourceLocation:	Source/Tortunabo/Private/Multiplayer/MP_GameInstance.cpp(901)
#: Source/Tortunabo/Private/Multiplayer/MP_GameInstance.cpp(901)
msgctxt "TNRooms,CodeFull"
msgid "«{0}» está llena ({1}/{2})."
msgstr "„{0}” jest pełny ({1}/{2})."

#. Key:	NoOpenRooms
#. SourceLocation:	Source/Tortunabo/Private/Multiplayer/MP_GameInstance.cpp(940)
#: Source/Tortunabo/Private/Multiplayer/MP_GameInstance.cpp(940)
msgctxt "TNRooms,NoOpenRooms"
