msgid "Trampolín"
msgstr "Trampolina"

#. Key:	TitleCatapult
#. SourceLocation:	Source/Tortunabo/Private/Lobby/TN_TutorialTexts.h(29)
#: Source/Tortunabo/Private/Lobby/TN_TutorialTexts.h(29)
