#: /Game/Blueprints/Gameplay/Cosmetics/DT_Skins.DT_Skins.Body_Teal.Description
msgctxt "DT_Skins,Body_Teal_Description"
msgid "Turquesa de laguna tropical. Te confundirán con el agua."
msgstr "Turkus tropikalnej laguny. Wezmą cię za wodę."

#. Key:	Body_Teal_DisplayName
#. SourceLocation:	/Game/Blueprints/Gameplay/Cosmetics/DT_Skins.DT_Skins.Body_Teal.DisplayName
#: /Game/Blueprints/Gameplay/Cosmetics/DT_Skins.DT_Skins.Body_Teal.DisplayName
