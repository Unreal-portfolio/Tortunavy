#: Source/Tortunabo/Private/UI/Pause/TN_PauseMenuWidget.cpp(2711)
msgctxt "TNPause,VRModeSim"
msgid "Simulado sin gafas"
msgstr "Symulowany bez gogli"

#. Key:	VRMode
