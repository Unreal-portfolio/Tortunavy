#: /Game/Blueprints/Gameplay/Cosmetics/DT_Skins.DT_Skins.Body_Sunny.Description
msgctxt "DT_Skins,Body_Sunny_Description"
msgid "Amarillo como el sol de mediodía. Se te ve desde lejos."
msgstr "Żółty jak południowe słońce. Widać cię z daleka."

#. Key:	Body_Sunny_DisplayName
#. SourceLocation:	/Game/Blueprints/Gameplay/Cosmetics/DT_Skins.DT_Skins.Body_Sunny.DisplayName
#: /Game/Blueprints/Gameplay/Cosmetics/DT_Skins.DT_Skins.Body_Sunny.DisplayName
msgctxt "DT_Skins,Body_Sunny_DisplayName"
msgid "Amarillo sol"
msgstr "Słoneczny żółty"

#. Key:	Body_Teal_Description
