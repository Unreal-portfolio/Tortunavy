#: /Game/Blueprints/Gameplay/Cosmetics/DT_Helmets.DT_Helmets.Helmet_Crown.Description
msgctxt "DT_Helmets,Helmet_Crown_Description"
msgid "Oro de verdad. Bueno, de verdad de la buena no, pero brilla igual."
msgstr "Prawdziwe złoto. No dobra, nie całkiem prawdziwe, ale błyszczy tak samo."

