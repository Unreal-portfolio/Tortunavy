msgstr "Zorza polarna w każdym oku. Nikt nie widział czegoś takiego."

#. Key:	Eyes_Aurora_DisplayName
#. SourceLocation:	/Game/Blueprints/Gameplay/Cosmetics/DT_Skins.DT_Skins.Eyes_Aurora.DisplayName
#: /Game/Blueprints/Gameplay/Cosmetics/DT_Skins.DT_Skins.Eyes_Aurora.DisplayName
msgctxt "DT_Skins,Eyes_Aurora_DisplayName"
msgid "Aurora"
msgstr "Zorza"

