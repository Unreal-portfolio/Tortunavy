msgid "Catapulta"
msgstr "Katapulta"

#. Key:	TitleSwim
#. SourceLocation:	Source/Tortunabo/Private/Lobby/TN_TutorialTexts.h(30)
#: Source/Tortunabo/Private/Lobby/TN_TutorialTexts.h(30)
msgctxt "TNTutorial,TitleSwim"
msgid "Nadar"
msgstr "Pływanie"

#. Key:	TitleCarry
#. SourceLocation:	Source/Tortunabo/Private/Lobby/TN_TutorialTexts.h(31)
#: Source/Tortunabo/Private/Lobby/TN_TutorialTexts.h(31)
msgctxt "TNTutorial,TitleCarry"
msgid "Coger a una tortuga"
msgstr "Chwytanie żółwia"

#. Key:	TitleEscape
#. SourceLocation:	Source/Tortunabo/Private/Lobby/TN_TutorialTexts.h(32)
#: Source/Tortunabo/Private/Lobby/TN_TutorialTexts.h(32)
msgctxt "TNTutorial,TitleEscape"
msgid "¡Que te cogen!"
msgstr "Ktoś cię złapał!"

#. Key:	TitleEmotes
#. SourceLocation:	Source/Tortunabo/Private/Lobby/TN_TutorialTexts.h(33)
#: Source/Tortunabo/Private/Lobby/TN_TutorialTexts.h(33)
