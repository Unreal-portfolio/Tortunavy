msgid "Efectos del clima"
msgstr "날씨 효과"

#. Key:	WeatherEffectsDesc
#. SourceLocation:	Source/Tortunabo/Private/UI/Pause/TN_PauseMenuWidget.cpp(2588)
#: Source/Tortunabo/Private/UI/Pause/TN_PauseMenuWidget.cpp(2588)
msgctxt "TNPause,WeatherEffectsDesc"
msgid "Cuánto cierran la vista la niebla y el color de la tormenta de arena. Bájalo si te cuesta ver o te marea. El viento sigue empujando igual."
msgstr "모래폭풍의 안개와 색이 시야를 얼마나 가리는지 정해요. 잘 안 보이거나 어지러우면 낮추세요. 바람이 미는 힘은 그대로예요."

#. Key:	Talkers
#. SourceLocation:	Source/Tortunabo/Private/UI/Pause/TN_PauseMenuWidget.cpp(2591)
#: Source/Tortunabo/Private/UI/Pause/TN_PauseMenuWidget.cpp(2591)
