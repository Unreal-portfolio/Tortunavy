msgstr "숯"

#. Key:	Body_Coral_Description
#. SourceLocation:	/Game/Blueprints/Gameplay/Cosmetics/DT_Skins.DT_Skins.Body_Coral.Description
#: /Game/Blueprints/Gameplay/Cosmetics/DT_Skins.DT_Skins.Body_Coral.Description
msgctxt "DT_Skins,Body_Coral_Description"
msgid "Rojo coral, el color de los valientes del arrecife."
msgstr "산호초의 용감한 이들이 입는 산호 빨강이에요."

#. Key:	Body_Coral_DisplayName
#. SourceLocation:	/Game/Blueprints/Gameplay/Cosmetics/DT_Skins.DT_Skins.Body_Coral.DisplayName
#: /Game/Blueprints/Gameplay/Cosmetics/DT_Skins.DT_Skins.Body_Coral.DisplayName
msgctxt "DT_Skins,Body_Coral_DisplayName"
msgid "Rojo coral"
msgstr "산호 빨강"

#. Key:	Body_Forest_Description
#. SourceLocation:	/Game/Blueprints/Gameplay/Cosmetics/DT_Skins.DT_Skins.Body_Forest.Description
#: /Game/Blueprints/Gameplay/Cosmetics/DT_Skins.DT_Skins.Body_Forest.Description
msgctxt "DT_Skins,Body_Forest_Description"
msgid "Verde oscuro de la selva profunda."
msgstr "깊은 정글의 짙은 초록이에요."

#. Key:	Body_Forest_DisplayName
#. SourceLocation:	/Game/Blueprints/Gameplay/Cosmetics/DT_Skins.DT_Skins.Body_Forest.DisplayName
#: /Game/Blueprints/Gameplay/Cosmetics/DT_Skins.DT_Skins.Body_Forest.DisplayName
msgctxt "DT_Skins,Body_Forest_DisplayName"
msgid "Verde bosque"
msgstr "숲 초록"

#. Key:	Body_Lavender_Description
#. SourceLocation:	/Game/Blueprints/Gameplay/Cosmetics/DT_Skins.DT_Skins.Body_Lavender.Description
#: /Game/Blueprints/Gameplay/Cosmetics/DT_Skins.DT_Skins.Body_Lavender.Description
msgctxt "DT_Skins,Body_Lavender_Description"
msgid "Morado lavanda: huele a playa tranquila."
msgstr "라벤더 보라색이에요. 조용한 해변 냄새가 나요."

#. Key:	Body_Lavender_DisplayName
#. SourceLocation:	/Game/Blueprints/Gameplay/Cosmetics/DT_Skins.DT_Skins.Body_Lavender.DisplayName
#: /Game/Blueprints/Gameplay/Cosmetics/DT_Skins.DT_Skins.Body_Lavender.DisplayName
msgctxt "DT_Skins,Body_Lavender_DisplayName"
