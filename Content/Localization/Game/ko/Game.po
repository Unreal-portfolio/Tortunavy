#. Key:	Helmet_Captain_Description
#. SourceLocation:	/Game/Blueprints/Gameplay/Cosmetics/DT_Helmets.DT_Helmets.Helmet_Captain.Description
#: /Game/Blueprints/Gameplay/Cosmetics/DT_Helmets.DT_Helmets.Helmet_Captain.Description
msgctxt "DT_Helmets,Helmet_Captain_Description"
msgid "Para quien lleva el timón de la tripulación."
msgstr "선원들의 키를 잡은 사람을 위한 모자예요."

#. Key:	Helmet_Captain_DisplayName
#. SourceLocation:	/Game/Blueprints/Gameplay/Cosmetics/DT_Helmets.DT_Helmets.Helmet_Captain.DisplayName
#: /Game/Blueprints/Gameplay/Cosmetics/DT_Helmets.DT_Helmets.Helmet_Captain.DisplayName
msgctxt "DT_Helmets,Helmet_Captain_DisplayName"
msgid "Gorra de capitán"
msgstr "선장 모자"

#. Key:	Helmet_Crab_Description
#. SourceLocation:	/Game/Blueprints/Gameplay/Cosmetics/DT_Helmets.DT_Helmets.Helmet_Crab.Description
#: /Game/Blueprints/Gameplay/Cosmetics/DT_Helmets.DT_Helmets.Helmet_Crab.Description
msgctxt "DT_Helmets,Helmet_Crab_Description"
msgid "Te acompaña a todas partes y te defiende de las gaviotas."
msgstr "어디든 따라와서 갈매기로부터 지켜 줘요."

#. Key:	Helmet_Crab_DisplayName
#. SourceLocation:	/Game/Blueprints/Gameplay/Cosmetics/DT_Helmets.DT_Helmets.Helmet_Crab.DisplayName
#: /Game/Blueprints/Gameplay/Cosmetics/DT_Helmets.DT_Helmets.Helmet_Crab.DisplayName
msgctxt "DT_Helmets,Helmet_Crab_DisplayName"
msgid "Cangrejo de compañía"
msgstr "반려 게"

#. Key:	Helmet_Crown_Description
#. SourceLocation:	/Game/Blueprints/Gameplay/Cosmetics/DT_Helmets.DT_Helmets.Helmet_Crown.Description
#: /Game/Blueprints/Gameplay/Cosmetics/DT_Helmets.DT_Helmets.Helmet_Crown.Description
msgctxt "DT_Helmets,Helmet_Crown_Description"
msgid "Oro de verdad. Bueno, de verdad de la buena no, pero brilla igual."
msgstr "진짜 금이에요. 뭐, 진짜 진짜는 아니지만 똑같이 반짝여요."

#. Key:	Helmet_Crown_DisplayName
#. SourceLocation:	/Game/Blueprints/Gameplay/Cosmetics/DT_Helmets.DT_Helmets.Helmet_Crown.DisplayName
#: /Game/Blueprints/Gameplay/Cosmetics/DT_Helmets.DT_Helmets.Helmet_Crown.DisplayName
msgctxt "DT_Helmets,Helmet_Crown_DisplayName"
msgid "Corona real"
msgstr "왕관"

#. Key:	Helmet_Halo_Description
#. SourceLocation:	/Game/Blueprints/Gameplay/Cosmetics/DT_Helmets.DT_Helmets.Helmet_Halo.Description
#: /Game/Blueprints/Gameplay/Cosmetics/DT_Helmets.DT_Helmets.Helmet_Halo.Description
msgctxt "DT_Helmets,Helmet_Halo_Description"
msgid "Para las tortugas más buenas del arrecife."
msgstr "산호초에서 가장 착한 거북이를 위한 거예요."

#. Key:	Helmet_Halo_DisplayName
#. SourceLocation:	/Game/Blueprints/Gameplay/Cosmetics/DT_Helmets.DT_Helmets.Helmet_Halo.DisplayName
#: /Game/Blueprints/Gameplay/Cosmetics/DT_Helmets.DT_Helmets.Helmet_Halo.DisplayName
msgctxt "DT_Helmets,Helmet_Halo_DisplayName"
msgid "Aureola"
msgstr "천사의 후광"

#. Key:	Helmet_Hibiscus_Description
#. SourceLocation:	/Game/Blueprints/Gameplay/Cosmetics/DT_Helmets.DT_Helmets.Helmet_Hibiscus.Description
#: /Game/Blueprints/Gameplay/Cosmetics/DT_Helmets.DT_Helmets.Helmet_Hibiscus.Description
msgctxt "DT_Helmets,Helmet_Hibiscus_Description"
msgid "Un hibisco recién cogido. Huele a vacaciones."
msgstr "막 딴 히비스커스예요. 휴가 냄새가 나요."

#. Key:	Helmet_Hibiscus_DisplayName
#. SourceLocation:	/Game/Blueprints/Gameplay/Cosmetics/DT_Helmets.DT_Helmets.Helmet_Hibiscus.DisplayName
#: /Game/Blueprints/Gameplay/Cosmetics/DT_Helmets.DT_Helmets.Helmet_Hibiscus.DisplayName
msgctxt "DT_Helmets,Helmet_Hibiscus_DisplayName"
msgid "Flor tropical"
msgstr "열대 꽃"

#. Key:	Helmet_Jelly_Description
#. SourceLocation:	/Game/Blueprints/Gameplay/Cosmetics/DT_Helmets.DT_Helmets.Helmet_Jelly.Description
#: /Game/Blueprints/Gameplay/Cosmetics/DT_Helmets.DT_Helmets.Helmet_Jelly.Description
msgctxt "DT_Helmets,Helmet_Jelly_Description"
msgid "Blandito y fresquito. No pica, te lo prometo."
msgstr "말랑말랑하고 시원해요. 안 쏘니까 걱정 마세요."

#. Key:	Helmet_Jelly_DisplayName
#. SourceLocation:	/Game/Blueprints/Gameplay/Cosmetics/DT_Helmets.DT_Helmets.Helmet_Jelly.DisplayName
#: /Game/Blueprints/Gameplay/Cosmetics/DT_Helmets.DT_Helmets.Helmet_Jelly.DisplayName
msgctxt "DT_Helmets,Helmet_Jelly_DisplayName"
msgid "Sombrero medusa"
msgstr "해파리 모자"

#. Key:	Helmet_Party_Description
#. SourceLocation:	/Game/Blueprints/Gameplay/Cosmetics/DT_Helmets.DT_Helmets.Helmet_Party.Description
#: /Game/Blueprints/Gameplay/Cosmetics/DT_Helmets.DT_Helmets.Helmet_Party.Description
msgctxt "DT_Helmets,Helmet_Party_Description"
msgid "¡Toda carrera terminada es motivo de celebración!"
msgstr "끝낸 레이스는 전부 축하할 일이에요!"

#. Key:	Helmet_Party_DisplayName
#. SourceLocation:	/Game/Blueprints/Gameplay/Cosmetics/DT_Helmets.DT_Helmets.Helmet_Party.DisplayName
#: /Game/Blueprints/Gameplay/Cosmetics/DT_Helmets.DT_Helmets.Helmet_Party.DisplayName
msgctxt "DT_Helmets,Helmet_Party_DisplayName"
msgid "Gorro de fiesta"
msgstr "파티 모자"

#. Key:	Helmet_Pirate_Description
#. SourceLocation:	/Game/Blueprints/Gameplay/Cosmetics/DT_Helmets.DT_Helmets.Helmet_Pirate.Description
#: /Game/Blueprints/Gameplay/Cosmetics/DT_Helmets.DT_Helmets.Helmet_Pirate.Description
msgctxt "DT_Helmets,Helmet_Pirate_Description"
msgid "Perteneció a un capitán muy temido... o eso me dijeron."
msgstr "엄청 무서운 선장의 것이었대요… 그런 말을 들었어요."

#. Key:	Helmet_Pirate_DisplayName
#. SourceLocation:	/Game/Blueprints/Gameplay/Cosmetics/DT_Helmets.DT_Helmets.Helmet_Pirate.DisplayName
#: /Game/Blueprints/Gameplay/Cosmetics/DT_Helmets.DT_Helmets.Helmet_Pirate.DisplayName
msgctxt "DT_Helmets,Helmet_Pirate_DisplayName"
msgid "Tricornio pirata"
msgstr "해적 삼각모"

#. Key:	Helmet_Propeller_Description
#. SourceLocation:	/Game/Blueprints/Gameplay/Cosmetics/DT_Helmets.DT_Helmets.Helmet_Propeller.Description
#: /Game/Blueprints/Gameplay/Cosmetics/DT_Helmets.DT_Helmets.Helmet_Propeller.Description
msgctxt "DT_Helmets,Helmet_Propeller_Description"
msgid "No vuela. Lo he probado. Pero queda genial."
msgstr "날지는 않아요. 해 봤어요. 그래도 멋져요."

#. Key:	Helmet_Propeller_DisplayName
#. SourceLocation:	/Game/Blueprints/Gameplay/Cosmetics/DT_Helmets.DT_Helmets.Helmet_Propeller.DisplayName
#: /Game/Blueprints/Gameplay/Cosmetics/DT_Helmets.DT_Helmets.Helmet_Propeller.DisplayName
msgctxt "DT_Helmets,Helmet_Propeller_DisplayName"
msgid "Gorro de hélice"
msgstr "프로펠러 모자"

#. Key:	Helmet_Sailor_Description
#. SourceLocation:	/Game/Blueprints/Gameplay/Cosmetics/DT_Helmets.DT_Helmets.Helmet_Sailor.Description
#: /Game/Blueprints/Gameplay/Cosmetics/DT_Helmets.DT_Helmets.Helmet_Sailor.Description
msgctxt "DT_Helmets,Helmet_Sailor_Description"
msgid "Con pompón rojo y cintas al viento. Muy marinero."
msgstr "빨간 방울과 바람에 날리는 리본이 달렸어요. 아주 뱃사람다워요."

#. Key:	Helmet_Sailor_DisplayName
#. SourceLocation:	/Game/Blueprints/Gameplay/Cosmetics/DT_Helmets.DT_Helmets.Helmet_Sailor.DisplayName
#: /Game/Blueprints/Gameplay/Cosmetics/DT_Helmets.DT_Helmets.Helmet_Sailor.DisplayName
msgctxt "DT_Helmets,Helmet_Sailor_DisplayName"
msgid "Gorro de marinero"
msgstr "수병 모자"

#. Key:	Helmet_Starfish_Description
#. SourceLocation:	/Game/Blueprints/Gameplay/Cosmetics/DT_Helmets.DT_Helmets.Helmet_Starfish.Description
#: /Game/Blueprints/Gameplay/Cosmetics/DT_Helmets.DT_Helmets.Helmet_Starfish.Description
msgctxt "DT_Helmets,Helmet_Starfish_Description"
msgid "Se llama Estrellita. Es muy tranquila, no muerde."
msgstr "이름은 별이예요. 아주 얌전해서 물지 않아요."

#. Key:	Helmet_Starfish_DisplayName
#. SourceLocation:	/Game/Blueprints/Gameplay/Cosmetics/DT_Helmets.DT_Helmets.Helmet_Starfish.DisplayName
#: /Game/Blueprints/Gameplay/Cosmetics/DT_Helmets.DT_Helmets.Helmet_Starfish.DisplayName
msgctxt "DT_Helmets,Helmet_Starfish_DisplayName"
msgid "Estrella de mar"
msgstr "불가사리"

#. Key:	Helmet_Straw_Description
#. SourceLocation:	/Game/Blueprints/Gameplay/Cosmetics/DT_Helmets.DT_Helmets.Helmet_Straw.Description
#: /Game/Blueprints/Gameplay/Cosmetics/DT_Helmets.DT_Helmets.Helmet_Straw.Description
msgctxt "DT_Helmets,Helmet_Straw_Description"
msgid "Fresquito para la playa. Con lazo coral, que es lo que se lleva."
msgstr "해변에서 시원해요. 산호색 리본이 달려 있어서 지금 유행이에요."

#. Key:	Helmet_Straw_DisplayName
#. SourceLocation:	/Game/Blueprints/Gameplay/Cosmetics/DT_Helmets.DT_Helmets.Helmet_Straw.DisplayName
#: /Game/Blueprints/Gameplay/Cosmetics/DT_Helmets.DT_Helmets.Helmet_Straw.DisplayName
msgctxt "DT_Helmets,Helmet_Straw_DisplayName"
msgid "Sombrero de paja"
msgstr "밀짚모자"

#. Key:	Body_Bubblegum_Description
#. SourceLocation:	/Game/Blueprints/Gameplay/Cosmetics/DT_Skins.DT_Skins.Body_Bubblegum.Description
#: /Game/Blueprints/Gameplay/Cosmetics/DT_Skins.DT_Skins.Body_Bubblegum.Description
msgctxt "DT_Skins,Body_Bubblegum_Description"
msgid "Rosa chicle con la barriga de nata. Muy dulce."
msgstr "풍선껌 핑크에 생크림색 배예요. 아주 달콤해요."

#. Key:	Body_Bubblegum_DisplayName
#. SourceLocation:	/Game/Blueprints/Gameplay/Cosmetics/DT_Skins.DT_Skins.Body_Bubblegum.DisplayName
#: /Game/Blueprints/Gameplay/Cosmetics/DT_Skins.DT_Skins.Body_Bubblegum.DisplayName
msgctxt "DT_Skins,Body_Bubblegum_DisplayName"
msgid "Rosa chicle"
msgstr "풍선껌 핑크"

#. Key:	Body_Charcoal_Description
#. SourceLocation:	/Game/Blueprints/Gameplay/Cosmetics/DT_Skins.DT_Skins.Body_Charcoal.Description
#: /Game/Blueprints/Gameplay/Cosmetics/DT_Skins.DT_Skins.Body_Charcoal.Description
msgctxt "DT_Skins,Body_Charcoal_Description"
msgid "Gris carbón con la barriga plateada. Misteriosa."
msgstr "숯 같은 회색에 은색 배예요. 신비로워요."

#. Key:	Body_Charcoal_DisplayName
#. SourceLocation:	/Game/Blueprints/Gameplay/Cosmetics/DT_Skins.DT_Skins.Body_Charcoal.DisplayName
#: /Game/Blueprints/Gameplay/Cosmetics/DT_Skins.DT_Skins.Body_Charcoal.DisplayName
msgctxt "DT_Skins,Body_Charcoal_DisplayName"
