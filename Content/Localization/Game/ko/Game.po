msgid "Quién habla (texto)"
msgstr "말하는 사람(글자)"

#. Key:	TalkersDesc
#. SourceLocation:	Source/Tortunabo/Private/UI/Pause/TN_PauseMenuWidget.cpp(2592)
#: Source/Tortunabo/Private/UI/Pause/TN_PauseMenuWidget.cpp(2592)
msgctxt "TNPause,TalkersDesc"
msgid "A la derecha de la pantalla, el nombre de quien está hablando por voz. Para jugar sin sonido o si oyes mal."
msgstr "화면 오른쪽에 음성으로 말하는 사람의 이름을 보여줘요. 소리 없이 하거나 잘 안 들릴 때 좋아요."

#. Key:	ResetGame
