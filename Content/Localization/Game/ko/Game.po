#: /Game/Blueprints/Gameplay/Cosmetics/DT_Skins.DT_Skins.Body_Lime.Description
msgctxt "DT_Skins,Body_Lime_Description"
msgid "Verde lima, ácido y veloz."
msgstr "라임 초록이에요. 새콤하고 빨라요."

#. Key:	Body_Lime_DisplayName
#. SourceLocation:	/Game/Blueprints/Gameplay/Cosmetics/DT_Skins.DT_Skins.Body_Lime.DisplayName
#: /Game/Blueprints/Gameplay/Cosmetics/DT_Skins.DT_Skins.Body_Lime.DisplayName
msgctxt "DT_Skins,Body_Lime_DisplayName"
msgid "Lima"
msgstr "라임"

#. Key:	Body_Mint_Description
