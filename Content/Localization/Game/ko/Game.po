#: Source/Tortunabo/Private/Lobby/TN_TutorialTexts.h(50)
msgctxt "TNTutorial,TaskDive"
msgid "En el aire, pulsa otra vez: te tiras en plancha"
msgstr "공중에서 한 번 더 누르면 배치기!"

#. Key:	TaskPickup
#. SourceLocation:	Source/Tortunabo/Private/Lobby/TN_TutorialTexts.h(51)
#: Source/Tortunabo/Private/Lobby/TN_TutorialTexts.h(51)
