msgid "Esprintar"
msgstr "Correre"

#. Key:	CtlShell
#. SourceLocation:	Source/Tortunabo/Private/UI/Briefing/TN_BriefingWidget.cpp(523)
#: Source/Tortunabo/Private/UI/Briefing/TN_BriefingWidget.cpp(523)
msgctxt "Tortunabo,CtlShell"
msgid "Meterse o salir del caparazón"
msgstr "Rientrare o uscire dal guscio"

#. Key:	CtlInteract
#. SourceLocation:	Source/Tortunabo/Private/UI/Briefing/TN_BriefingWidget.cpp(524)
#: Source/Tortunabo/Private/UI/Briefing/TN_BriefingWidget.cpp(524)
msgctxt "Tortunabo,CtlInteract"
msgid "Interactuar, coger y lanzar"
msgstr "Interagire, prendere e lanciare"

#. Key:	CtlDrop
#. SourceLocation:	Source/Tortunabo/Private/UI/Briefing/TN_BriefingWidget.cpp(525)
#: Source/Tortunabo/Private/UI/Briefing/TN_BriefingWidget.cpp(525)
msgctxt "Tortunabo,CtlDrop"
msgid "Soltar el objeto (o a quien llevas)"
msgstr "Lasciare l’oggetto (o chi porti)"

#. Key:	CtlRotate
#. SourceLocation:	Source/Tortunabo/Private/UI/Briefing/TN_BriefingWidget.cpp(526)
#: Source/Tortunabo/Private/UI/Briefing/TN_BriefingWidget.cpp(526)
msgctxt "Tortunabo,CtlRotate"
msgid "Cambiar de objeto"
msgstr "Cambiare oggetto"

#. Key:	CtlEmoteWheel
#. SourceLocation:	Source/Tortunabo/Private/UI/Briefing/TN_BriefingWidget.cpp(527)
#: Source/Tortunabo/Private/UI/Briefing/TN_BriefingWidget.cpp(527)
