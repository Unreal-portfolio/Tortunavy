msgid "Saltar (en el aire, otra vez: panzazo)"
msgstr "Saltare (in aria, di nuovo: spanciata)"

#. Key:	CtlSprint
#. SourceLocation:	Source/Tortunabo/Private/UI/Briefing/TN_BriefingWidget.cpp(522)
#: Source/Tortunabo/Private/UI/Briefing/TN_BriefingWidget.cpp(522)
