msgid "Tortugas por buggy"
msgstr "Tartarughe per buggy"

#. Key:	BriefingRallyCircuitH
#. SourceLocation:	Source/Tortunabo/Private/UI/Briefing/TN_BriefingWidget.cpp(748)
#: Source/Tortunabo/Private/UI/Briefing/TN_BriefingWidget.cpp(748)
msgctxt "Tortunabo,BriefingRallyCircuitH"
