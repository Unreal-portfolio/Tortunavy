msgid "Séptima. El gusano ya había reservado mesa."
msgstr "Settima. Il verme aveva già prenotato il tavolo."

#. Key:	Arrival7b
#. SourceLocation:	Source/Tortunabo/Private/UI/Race/TN_RaceArrivalWidget.cpp(119)
#: Source/Tortunabo/Private/UI/Race/TN_RaceArrivalWidget.cpp(119)
msgctxt "TNRace,Arrival7b"
msgid "Séptima. Tu premio huele igual que tu carrera."
msgstr "Settima. Il tuo premio ha lo stesso odore della tua gara."

#. Key:	Arrival7c
#. SourceLocation:	Source/Tortunabo/Private/UI/Race/TN_RaceArrivalWidget.cpp(120)
#: Source/Tortunabo/Private/UI/Race/TN_RaceArrivalWidget.cpp(120)
msgctxt "TNRace,Arrival7c"
msgid "Séptima. Un calcetín con arena: útil para… nada."
msgstr "Settima. Un calzino pieno di sabbia: utile per... niente."

#. Key:	Arrival8a
#. SourceLocation:	Source/Tortunabo/Private/UI/Race/TN_RaceArrivalWidget.cpp(123)
#: Source/Tortunabo/Private/UI/Race/TN_RaceArrivalWidget.cpp(123)
