msgctxt "Tortunabo,BoothKeysPages"
msgid "Arriba/abajo: fila · Izquierda/derecha: cambiar · Q/E: tortuga o buggy · Intro: listo · Esc: cancelar"
msgstr "Su/giù: riga · Sinistra/destra: cambia · Q/E: tartaruga o buggy · Invio: pronta · Esc: annulla"

#. Key:	BuggyPaintMariquita
#. SourceLocation:	Source/Tortunabo/Private/Vehicles/TN_BuggyCosmetics.cpp(102)
#: Source/Tortunabo/Private/Vehicles/TN_BuggyCosmetics.cpp(102)
msgctxt "Tortunabo,BuggyPaintMariquita"
msgid "Mariquita"
msgstr "Coccinella"

#. Key:	BuggyPaintMariquitaDesc
#. SourceLocation:	Source/Tortunabo/Private/Vehicles/TN_BuggyCosmetics.cpp(103)
#: Source/Tortunabo/Private/Vehicles/TN_BuggyCosmetics.cpp(103)
msgctxt "Tortunabo,BuggyPaintMariquitaDesc"
msgid "Rojo con lunares negros. Trae suerte, o eso dice mi abuela, que tiene ciento veinte años."
msgstr "Rossa a pois neri. Porta fortuna, o almeno così dice mia nonna, che ha centovent’anni."

#. Key:	BuggyPaintMedusa
#. SourceLocation:	Source/Tortunabo/Private/Vehicles/TN_BuggyCosmetics.cpp(106)
#: Source/Tortunabo/Private/Vehicles/TN_BuggyCosmetics.cpp(106)
msgctxt "Tortunabo,BuggyPaintMedusa"
msgid "Medusa Rosa"
msgstr "Medusa rosa"

#. Key:	BuggyPaintMedusaDesc
#. SourceLocation:	Source/Tortunabo/Private/Vehicles/TN_BuggyCosmetics.cpp(107)
#: Source/Tortunabo/Private/Vehicles/TN_BuggyCosmetics.cpp(107)
msgctxt "Tortunabo,BuggyPaintMedusaDesc"
msgid "Rosa medusa con burbujitas. No pica, te lo prometo."
msgstr "Rosa medusa con bollicine. Non punge, te lo prometto."

#. Key:	BuggyPaintOro
#. SourceLocation:	Source/Tortunabo/Private/Vehicles/TN_BuggyCosmetics.cpp(110)
#: Source/Tortunabo/Private/Vehicles/TN_BuggyCosmetics.cpp(110)
msgctxt "Tortunabo,BuggyPaintOro"
msgid "Oro Pirata"
msgstr "Oro pirata"

#. Key:	BuggyPaintOroDesc
#. SourceLocation:	Source/Tortunabo/Private/Vehicles/TN_BuggyCosmetics.cpp(111)
#: Source/Tortunabo/Private/Vehicles/TN_BuggyCosmetics.cpp(111)
msgctxt "Tortunabo,BuggyPaintOroDesc"
msgid "Oro del galeón hundido, pulido a mano. Es lo más caro de la tienda, y se nota desde la luna."
msgstr "Oro del galeone affondato, lucidato a mano. È la cosa più cara del negozio, e si vede dalla luna."

#. Key:	BuggyPaintPlata
#. SourceLocation:	Source/Tortunabo/Private/Vehicles/TN_BuggyCosmetics.cpp(114)
#: Source/Tortunabo/Private/Vehicles/TN_BuggyCosmetics.cpp(114)
msgctxt "Tortunabo,BuggyPaintPlata"
msgid "Plata Pulida"
msgstr "Argento lucido"

#. Key:	BuggyPaintPlataDesc
#. SourceLocation:	Source/Tortunabo/Private/Vehicles/TN_BuggyCosmetics.cpp(115)
#: Source/Tortunabo/Private/Vehicles/TN_BuggyCosmetics.cpp(115)
msgctxt "Tortunabo,BuggyPaintPlataDesc"
msgid "Brilla como un espejo. Peinarse antes de cada carrera es obligatorio."
msgstr "Brilla come uno specchio. Pettinarsi prima di ogni gara è obbligatorio."

#. Key:	BuggyPaintAlga
#. SourceLocation:	Source/Tortunabo/Private/Vehicles/TN_BuggyCosmetics.cpp(118)
#: Source/Tortunabo/Private/Vehicles/TN_BuggyCosmetics.cpp(118)
msgctxt "Tortunabo,BuggyPaintAlga"
msgid "Camuflaje de Alga"
msgstr "Mimetica d’alga"

#. Key:	BuggyPaintAlgaDesc
#. SourceLocation:	Source/Tortunabo/Private/Vehicles/TN_BuggyCosmetics.cpp(119)
#: Source/Tortunabo/Private/Vehicles/TN_BuggyCosmetics.cpp(119)
msgctxt "Tortunabo,BuggyPaintAlgaDesc"
msgid "Para esconderse entre las algas. Los cangrejos no te verán venir."
msgstr "Per nascondersi tra le alghe. I granchi non ti vedranno arrivare."

#. Key:	BuggyPaintLlamas
#. SourceLocation:	Source/Tortunabo/Private/Vehicles/TN_BuggyCosmetics.cpp(122)
#: Source/Tortunabo/Private/Vehicles/TN_BuggyCosmetics.cpp(122)
msgctxt "Tortunabo,BuggyPaintLlamas"
msgid "Llamas Infernales"
msgstr "Fiamme infernali"

#. Key:	BuggyPaintLlamasDesc
#. SourceLocation:	Source/Tortunabo/Private/Vehicles/TN_BuggyCosmetics.cpp(123)
#: Source/Tortunabo/Private/Vehicles/TN_BuggyCosmetics.cpp(123)
msgctxt "Tortunabo,BuggyPaintLlamasDesc"
msgid "Llamas de hot rod que salen del morro. No queman, pero dan muchísimo miedo."
msgstr "Fiamme da hot rod che escono dal muso. Non bruciano, ma fanno una paura tremenda."

#. Key:	BuggyPaintCarreras
#. SourceLocation:	Source/Tortunabo/Private/Vehicles/TN_BuggyCosmetics.cpp(126)
#: Source/Tortunabo/Private/Vehicles/TN_BuggyCosmetics.cpp(126)
msgctxt "Tortunabo,BuggyPaintCarreras"
msgid "Rayas de Carreras"
msgstr "Strisce da corsa"

#. Key:	BuggyPaintCarrerasDesc
#. SourceLocation:	Source/Tortunabo/Private/Vehicles/TN_BuggyCosmetics.cpp(127)
#: Source/Tortunabo/Private/Vehicles/TN_BuggyCosmetics.cpp(127)
msgctxt "Tortunabo,BuggyPaintCarrerasDesc"
msgid "Azul con dos rayas blancas, como los coches de carreras de antes. Más rápido no va, pero lo parece."
msgstr "Blu con due strisce bianche, come le auto da corsa di una volta. Più veloce non va, ma sembra."

#. Key:	BuggyPaintAbisal
#. SourceLocation:	Source/Tortunabo/Private/Vehicles/TN_BuggyCosmetics.cpp(130)
#: Source/Tortunabo/Private/Vehicles/TN_BuggyCosmetics.cpp(130)
msgctxt "Tortunabo,BuggyPaintAbisal"
msgid "Abisal Luminosa"
msgstr "Abisso luminoso"

#. Key:	BuggyPaintAbisalDesc
#. SourceLocation:	Source/Tortunabo/Private/Vehicles/TN_BuggyCosmetics.cpp(131)
#: Source/Tortunabo/Private/Vehicles/TN_BuggyCosmetics.cpp(131)
msgctxt "Tortunabo,BuggyPaintAbisalDesc"
msgid "Como los peces del fondo del mar: lunares que brillan en la oscuridad. Ideal para los túneles."
msgstr "Come i pesci degli abissi: pois che brillano al buio. Ideale per le gallerie."

#. Key:	BuggyPaintCarey
#. SourceLocation:	Source/Tortunabo/Private/Vehicles/TN_BuggyCosmetics.cpp(134)
#: Source/Tortunabo/Private/Vehicles/TN_BuggyCosmetics.cpp(134)
msgctxt "Tortunabo,BuggyPaintCarey"
msgid "Carey"
msgstr "Embricata"

#. Key:	BuggyPaintCareyDesc
#. SourceLocation:	Source/Tortunabo/Private/Vehicles/TN_BuggyCosmetics.cpp(135)
#: Source/Tortunabo/Private/Vehicles/TN_BuggyCosmetics.cpp(135)
msgctxt "Tortunabo,BuggyPaintCareyDesc"
msgid "El dibujo de la tortuga carey, con su brillo de caramelo. Un clásico de la familia."
msgstr "Il disegno della tartaruga embricata, con il suo riflesso di caramello. Un classico di famiglia."

#. Key:	BuggyPaintHielo
#. SourceLocation:	Source/Tortunabo/Private/Vehicles/TN_BuggyCosmetics.cpp(138)
#: Source/Tortunabo/Private/Vehicles/TN_BuggyCosmetics.cpp(138)
msgctxt "Tortunabo,BuggyPaintHielo"
msgid "Hielo Polar"
msgstr "Ghiaccio polare"

#. Key:	BuggyPaintHieloDesc
#. SourceLocation:	Source/Tortunabo/Private/Vehicles/TN_BuggyCosmetics.cpp(139)
#: Source/Tortunabo/Private/Vehicles/TN_BuggyCosmetics.cpp(139)
msgctxt "Tortunabo,BuggyPaintHieloDesc"
msgid "Blanco y azul hielo. Para las tortugas que se escaparon del Ártico."
msgstr "Bianco e azzurro ghiaccio. Per le tartarughe scappate dall’Artico."

#. Key:	BuggyPaintAtardecer
#. SourceLocation:	Source/Tortunabo/Private/Vehicles/TN_BuggyCosmetics.cpp(142)
#: Source/Tortunabo/Private/Vehicles/TN_BuggyCosmetics.cpp(142)
msgctxt "Tortunabo,BuggyPaintAtardecer"
msgid "Atardecer Tropical"
msgstr "Tramonto tropicale"

#. Key:	BuggyPaintAtardecerDesc
#. SourceLocation:	Source/Tortunabo/Private/Vehicles/TN_BuggyCosmetics.cpp(143)
#: Source/Tortunabo/Private/Vehicles/TN_BuggyCosmetics.cpp(143)
msgctxt "Tortunabo,BuggyPaintAtardecerDesc"
msgid "Naranja, oro y morado de puesta de sol. Queda precioso en las fotos de la meta."
msgstr "Arancio, oro e viola da tramonto. Sta benissimo nelle foto del traguardo."

#. Key:	BuggyPaintTiburon
#. SourceLocation:	Source/Tortunabo/Private/Vehicles/TN_BuggyCosmetics.cpp(146)
#: Source/Tortunabo/Private/Vehicles/TN_BuggyCosmetics.cpp(146)
msgctxt "Tortunabo,BuggyPaintTiburon"
msgid "Tiburón"
msgstr "Squalo"

#. Key:	BuggyPaintTiburonDesc
#. SourceLocation:	Source/Tortunabo/Private/Vehicles/TN_BuggyCosmetics.cpp(147)
#: Source/Tortunabo/Private/Vehicles/TN_BuggyCosmetics.cpp(147)
msgctxt "Tortunabo,BuggyPaintTiburonDesc"
msgid "Gris tiburón con la barriga blanca. Los demás buggies se apartan solos."
msgstr "Grigio squalo con la pancia bianca. Gli altri buggy si spostano da soli."

#. Key:	BuggyPaintPulpo
#. SourceLocation:	Source/Tortunabo/Private/Vehicles/TN_BuggyCosmetics.cpp(150)
#: Source/Tortunabo/Private/Vehicles/TN_BuggyCosmetics.cpp(150)
msgctxt "Tortunabo,BuggyPaintPulpo"
msgid "Pulpo Morado"
msgstr "Polpo viola"

#. Key:	BuggyPaintPulpoDesc
#. SourceLocation:	Source/Tortunabo/Private/Vehicles/TN_BuggyCosmetics.cpp(151)
#: Source/Tortunabo/Private/Vehicles/TN_BuggyCosmetics.cpp(151)
msgctxt "Tortunabo,BuggyPaintPulpoDesc"
msgid "Morado de pulpo con ventosas de mentira. Ocho brazos para el volante, por si acaso."
msgstr "Viola polpo con ventose finte. Otto braccia per il volante, non si sa mai."

#. Key:	BuggyPaintCaramelo
#. SourceLocation:	Source/Tortunabo/Private/Vehicles/TN_BuggyCosmetics.cpp(154)
#: Source/Tortunabo/Private/Vehicles/TN_BuggyCosmetics.cpp(154)
msgctxt "Tortunabo,BuggyPaintCaramelo"
msgid "Caramelo de Feria"
msgstr "Caramella del luna park"

#. Key:	BuggyPaintCarameloDesc
#. SourceLocation:	Source/Tortunabo/Private/Vehicles/TN_BuggyCosmetics.cpp(155)
#: Source/Tortunabo/Private/Vehicles/TN_BuggyCosmetics.cpp(155)
msgctxt "Tortunabo,BuggyPaintCarameloDesc"
msgid "Rosa y blanco como un algodón de azúcar. Pegajoso no es: lo he comprobado."
msgstr "Rosa e bianco come lo zucchero filato. Appiccicoso non è: ho controllato."

#. Key:	BuggyModelStock
#. SourceLocation:	Source/Tortunabo/Private/Vehicles/TN_BuggyCosmetics.cpp(49)
#: Source/Tortunabo/Private/Vehicles/TN_BuggyCosmetics.cpp(49)
msgctxt "Tortunabo,BuggyModelStock"
msgid "Buggy de Serie"
msgstr "Buggy di serie"

#. Key:	BuggyModelStockDesc
#. SourceLocation:	Source/Tortunabo/Private/Vehicles/TN_BuggyCosmetics.cpp(50)
#: Source/Tortunabo/Private/Vehicles/TN_BuggyCosmetics.cpp(50)
msgctxt "Tortunabo,BuggyModelStockDesc"
msgid "El buggy oficial del Rally: chasis de tubos, pontones con dorsal y el color de tu equipo. Gratis y a prueba de cocos."
msgstr "Il buggy ufficiale del Rally: telaio tubolare, pance laterali col numero e il colore della tua squadra. Gratis e a prova di cocco."

#. Key:	BuggyModelClassic
#. SourceLocation:	Source/Tortunabo/Private/Vehicles/TN_BuggyCosmetics.cpp(52)
#: Source/Tortunabo/Private/Vehicles/TN_BuggyCosmetics.cpp(52)
msgctxt "Tortunabo,BuggyModelClassic"
msgid "Buggy Clásico"
msgstr "Buggy classico"

#. Key:	BuggyModelClassicDesc
#. SourceLocation:	Source/Tortunabo/Private/Vehicles/TN_BuggyCosmetics.cpp(53)
#: Source/Tortunabo/Private/Vehicles/TN_BuggyCosmetics.cpp(53)
msgctxt "Tortunabo,BuggyModelClassicDesc"
msgid "Un buggy que es una tortuga: caparazón de placas, aletas por guardabarros y unos ojos que alumbran la pista."
msgstr "Un buggy che è una tartaruga: guscio a piastre, pinne come parafanghi e occhi che illuminano la pista."

#. Key:	BuggyModelCaiman
#. SourceLocation:	Source/Tortunabo/Private/Vehicles/TN_BuggyCosmetics.cpp(55)
#: Source/Tortunabo/Private/Vehicles/TN_BuggyCosmetics.cpp(55)
msgctxt "Tortunabo,BuggyModelCaiman"
msgid "Caimán Todoterreno"
msgstr "Fuoristrada azzannatrice"

#. Key:	BuggyModelCaimanDesc
#. SourceLocation:	Source/Tortunabo/Private/Vehicles/TN_BuggyCosmetics.cpp(56)
#: Source/Tortunabo/Private/Vehicles/TN_BuggyCosmetics.cpp(56)
msgctxt "Tortunabo,BuggyModelCaimanDesc"
msgid "Como la tortuga caimán: placas con pinchos, pico de hierro y un tubo de buceo por si toca cruzar un río."
msgstr "Come la tartaruga azzannatrice: piastre con spuntoni, becco di ferro e uno snorkel se c’è da guadare un fiume."

#. Key:	BuggyModelLaud
#. SourceLocation:	Source/Tortunabo/Private/Vehicles/TN_BuggyCosmetics.cpp(58)
#: Source/Tortunabo/Private/Vehicles/TN_BuggyCosmetics.cpp(58)
msgctxt "Tortunabo,BuggyModelLaud"
msgid "Laúd Bólido"
msgstr "Bolide liuto"

#. Key:	BuggyModelLaudDesc
#. SourceLocation:	Source/Tortunabo/Private/Vehicles/TN_BuggyCosmetics.cpp(59)
#: Source/Tortunabo/Private/Vehicles/TN_BuggyCosmetics.cpp(59)
msgctxt "Tortunabo,BuggyModelLaudDesc"
msgid "La tortuga laúd es la más rápida del mar, y este bólido también: caparazón de crestas, alerón gigante y escapes laterales."
msgstr "La tartaruga liuto è la più veloce del mare, e questo bolide pure: guscio a creste, alettone gigante e scarichi laterali."

#. Key:	BuggyPaintSerie
#. SourceLocation:	Source/Tortunabo/Private/Vehicles/TN_BuggyCosmetics.cpp(70)
#: Source/Tortunabo/Private/Vehicles/TN_BuggyCosmetics.cpp(70)
msgctxt "Tortunabo,BuggyPaintSerie"
msgid "Pintura de serie"
msgstr "Vernice di serie"

#. Key:	BuggyPaintSerieDesc
#. SourceLocation:	Source/Tortunabo/Private/Vehicles/TN_BuggyCosmetics.cpp(71)
#: Source/Tortunabo/Private/Vehicles/TN_BuggyCosmetics.cpp(71)
msgctxt "Tortunabo,BuggyPaintSerieDesc"
msgid "La de fábrica: el buggy de serie lleva el color de tu equipo y las tortugas, su verde natural."
msgstr "Quella di fabbrica: il buggy di serie porta il colore della tua squadra, e le tartarughe il loro verde naturale."

#. Key:	BuggyPaintCoral
#. SourceLocation:	Source/Tortunabo/Private/Vehicles/TN_BuggyCosmetics.cpp(74)
#: Source/Tortunabo/Private/Vehicles/TN_BuggyCosmetics.cpp(74)
msgctxt "Tortunabo,BuggyPaintCoral"
msgid "Coral Bravo"
msgstr "Corallo grintoso"

#. Key:	BuggyPaintCoralDesc
#. SourceLocation:	Source/Tortunabo/Private/Vehicles/TN_BuggyCosmetics.cpp(75)
#: Source/Tortunabo/Private/Vehicles/TN_BuggyCosmetics.cpp(75)
msgctxt "Tortunabo,BuggyPaintCoralDesc"
msgid "Rojo coral para las que salen a ganar. Dicen que corre un diez por ciento más. Lo dicen."
msgstr "Rosso corallo per chi scende in pista per vincere. Dicono che vada il dieci per cento più veloce. Dicono."

#. Key:	BuggyPaintMarino
#. SourceLocation:	Source/Tortunabo/Private/Vehicles/TN_BuggyCosmetics.cpp(78)
#: Source/Tortunabo/Private/Vehicles/TN_BuggyCosmetics.cpp(78)
msgctxt "Tortunabo,BuggyPaintMarino"
msgid "Azul Marino"
msgstr "Blu marino"

#. Key:	BuggyPaintMarinoDesc
#. SourceLocation:	Source/Tortunabo/Private/Vehicles/TN_BuggyCosmetics.cpp(79)
#: Source/Tortunabo/Private/Vehicles/TN_BuggyCosmetics.cpp(79)
msgctxt "Tortunabo,BuggyPaintMarinoDesc"
msgid "Azul de alta mar con olas de espuma. Para tortugas que echan de menos el océano."
msgstr "Blu d’alto mare con onde di schiuma. Per le tartarughe che sentono la mancanza dell’oceano."

#. Key:	BuggyPaintArena
#. SourceLocation:	Source/Tortunabo/Private/Vehicles/TN_BuggyCosmetics.cpp(82)
#: Source/Tortunabo/Private/Vehicles/TN_BuggyCosmetics.cpp(82)
msgctxt "Tortunabo,BuggyPaintArena"
msgid "Arena Dorada"
msgstr "Sabbia dorata"

#. Key:	BuggyPaintArenaDesc
#. SourceLocation:	Source/Tortunabo/Private/Vehicles/TN_BuggyCosmetics.cpp(83)
#: Source/Tortunabo/Private/Vehicles/TN_BuggyCosmetics.cpp(83)
msgctxt "Tortunabo,BuggyPaintArenaDesc"
msgid "Del color de la playa donde naciste. Disimula de maravilla el barro."
msgstr "Del colore della spiaggia dove sei nata. Nasconde il fango a meraviglia."

#. Key:	BuggyPaintSandia
#. SourceLocation:	Source/Tortunabo/Private/Vehicles/TN_BuggyCosmetics.cpp(86)
#: Source/Tortunabo/Private/Vehicles/TN_BuggyCosmetics.cpp(86)
msgctxt "Tortunabo,BuggyPaintSandia"
msgid "Sandía Veraniega"
msgstr "Anguria d’estate"

#. Key:	BuggyPaintSandiaDesc
#. SourceLocation:	Source/Tortunabo/Private/Vehicles/TN_BuggyCosmetics.cpp(87)
#: Source/Tortunabo/Private/Vehicles/TN_BuggyCosmetics.cpp(87)
msgctxt "Tortunabo,BuggyPaintSandiaDesc"
msgid "Rayas de sandía y aletas rosas. Huele a verano, pero no se come."
msgstr "Strisce d’anguria e pinne rosa. Profuma d’estate, ma non si mangia."

#. Key:	BuggyPaintMeta
#. SourceLocation:	Source/Tortunabo/Private/Vehicles/TN_BuggyCosmetics.cpp(90)
#: Source/Tortunabo/Private/Vehicles/TN_BuggyCosmetics.cpp(90)
msgctxt "Tortunabo,BuggyPaintMeta"
